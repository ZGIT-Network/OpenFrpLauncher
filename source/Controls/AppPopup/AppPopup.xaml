<UserControl
    x:Class="OpenFrp.Launcher.Controls.AppPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf">

    <Grid Margin="8">
        <ink:ThemeShadowChrome
            CornerRadius="4"
            Depth="20"
            IsShadowEnabled="True" />
        <Border
            Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="4"
            SnapsToDevicePixels="True" />
        <Border
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0"
            CornerRadius="4">
            <Grid Margin="6">
                <Grid.Resources>
                    <Style TargetType="ink:HyperlinkButton">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <!--<Setter Property="Foreground" Value="{DynamicResource systemcontrol}" />-->
                    </Style>
                </Grid.Resources>
                <xa:SimpleStackPanel HorizontalAlignment="Stretch" Spacing="0">

                    <xa:SimpleStackPanel Margin="10,10,10,10" Spacing="4">
                        <TextBlock
                            FontFamily="{StaticResource SoraMediumMixYahei}"
                            FontSize="14"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{x:Static local:App.UiLauncherVersionString}"
                            TextWrapping="Wrap" />
                        <!--<TextBlock
                            FontFamily="{StaticResource SoraMediumMixYahei}"
                            FontSize="16"
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                            Text="越越" />-->
                    </xa:SimpleStackPanel>
                    <ink:HyperlinkButton x:Name="displayWindow" AutomationProperties.Name="显示启动器">
                        <xa:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                            <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.GoMirrored}" />
                            <TextBlock Text="显示启动器" />
                        </xa:SimpleStackPanel>
                    </ink:HyperlinkButton>
                    <Rectangle
                        Height="1"
                        Margin="0,4"
                        Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    <ink:HyperlinkButton x:Name="closeLauncher" AutomationProperties.Name="退出启动器">
                        <xa:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                            <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.ClosePane}" />
                            <TextBlock Text="退出启动器" />
                        </xa:SimpleStackPanel>
                    </ink:HyperlinkButton>
                    <ink:HyperlinkButton x:Name="closeAll" AutomationProperties.Name="退出启动器">
                        <xa:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                            <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.ChromeClose}" />
                            <TextBlock Text="彻底退出" />
                        </xa:SimpleStackPanel>
                    </ink:HyperlinkButton>
                </xa:SimpleStackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>