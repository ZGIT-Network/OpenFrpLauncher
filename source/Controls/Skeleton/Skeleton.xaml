<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern">
    <Style TargetType="ctrl:Skeleton">
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:Skeleton">
                    <Grid x:Name="container">
                        <!--  Light  -->
                        <Border
                            x:Name="bg1"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Focusable="False">
                            <Border.Background>
                                <SolidColorBrush />
                            </Border.Background>
                        </Border>
                        <!--  Dark  -->
                        <Border
                            x:Name="bg2"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Focusable="False">
                            <Border.Background>
                                <SolidColorBrush />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Resources>
                        <CubicEase x:Key="easingOutFunc" EasingMode="EaseOut" />
                        <CubicEase x:Key="easingInFunc" EasingMode="EaseIn" />
                    </ControlTemplate.Resources>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ink:ThemeManager.ActualTheme" Value="Dark">
                            <Setter TargetName="bg1" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ink:ThemeManager.ActualTheme" Value="Light">
                            <Setter TargetName="bg2" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="foreverStory">
                                    <Storyboard>

                                        <ColorAnimationUsingKeyFrames
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="bg2"
                                            Storyboard.TargetProperty="Background.Color"
                                            Duration="0:0:2">
                                            <EasingColorKeyFrame
                                                EasingFunction="{StaticResource easingOutFunc}"
                                                KeyTime="0:0:0"
                                                Value="#0CFFFFFF" />
                                            <EasingColorKeyFrame
                                                EasingFunction="{StaticResource easingOutFunc}"
                                                KeyTime="0:0:1"
                                                Value="#1CFFFFFF" />
                                            <EasingColorKeyFrame
                                                EasingFunction="{StaticResource easingInFunc}"
                                                KeyTime="0:0:2"
                                                Value="#0CFFFFFF" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="bg1"
                                            Storyboard.TargetProperty="Background.Color"
                                            Duration="0:0:2">
                                            <EasingColorKeyFrame
                                                EasingFunction="{StaticResource easingOutFunc}"
                                                KeyTime="0:0:0"
                                                Value="#CFEEEEEE" />
                                            <EasingColorKeyFrame
                                                EasingFunction="{StaticResource easingOutFunc}"
                                                KeyTime="0:0:1"
                                                Value="#CFDDDDDD" />
                                            <EasingColorKeyFrame
                                                EasingFunction="{StaticResource easingInFunc}"
                                                KeyTime="0:0:2"
                                                Value="#CFEEEEEE" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>