<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf">
    <!--  HyperLinkButton 的优化，现在默认情况下内容文本不会显示成 主题色  -->
    <Style x:Key="ButtonStyledHyperlinkButton" TargetType="ink:HyperlinkButton">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundThemeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="local:UserTunnel">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Awe__ControlFocusVisualStyle}" />
        <Setter Property="IsEnabled" Value="{Binding Tunnel.IsEnable, RelativeSource={RelativeSource Mode=Self}, Mode=OneWay}" />
        <Setter Property="TabIndex" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:UserTunnel">
                    <ControlTemplate.Resources>
                        <CubicEase x:Key="__ApCubicEase" />
                        <conv:EitherConverter x:Key="ReflagdEitherConverter" ReflagValue="True" />


                    </ControlTemplate.Resources>
                    <Border
                        x:Name="subfr"
                        Width="360"
                        Height="200"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        DataContext="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}"
                        RenderTransformOrigin=".5,.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid DataContext="{Binding Tunnel, Mode=OneWay}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ink:ToggleSwitch
                                Name="switcher"
                                Grid.Row="0"
                                Grid.Column="1"
                                MinWidth="0"
                                Margin="0,20,24,0"
                                IsRightAlignedCompact="True"
                                TabIndex="1" />
                            <!--  昵称，ID, 節點 ID, 以及節點名稱  -->
                            <xa:SimpleStackPanel
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="20,22,0,0"
                                Orientation="Vertical"
                                Spacing="2">
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Margin="0,-2,4,0"
                                        Padding="12,4,10,4"
                                        VerticalAlignment="Center"
                                        Background="#9f4096ff"
                                        CornerRadius="12"
                                        ToolTip="通过网页版快速启动。"
                                        Visibility="{Binding IsFastLaunch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <TextBlock FontSize="13" Text="快捷启动" />
                                    </Border>
                                    <TextBlock FontFamily="{StaticResource SoraMedium}">
                                        <Run FontSize="20" Text="{Binding Name, Mode=OneWay}" />
                                        <Run
                                            FontSize="16"
                                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                            Text="{Binding Id, StringFormat='#{0}', Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Visibility="{Binding IsNotFastLaunch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                    <Run
                                        FontFamily="{StaticResource SoraMedium}"
                                        FontSize="18"
                                        Text="{Binding Tunnel.NodeId, RelativeSource={RelativeSource Mode=TemplatedParent}, StringFormat='#{0}', Mode=OneWay}" />
                                    <Run
                                        FontSize="16"
                                        Text="{Binding NodeName, Mode=OneWay}"
                                        TextOptions.TextFormattingMode="Display" />
                                </TextBlock>
                                <!--<TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                    <Run
                                        FontFamily="{StaticResource SoraMedium}"
                                        FontSize="18"
                                        Text="{Binding Tunnel.NodeId, RelativeSource={RelativeSource Mode=TemplatedParent}, StringFormat='#{0}', Mode=OneWay}" />
                                    <Run
                                        FontSize="16"
                                        Text="{Binding NodeName, Mode=OneWay}"
                                        TextOptions.TextFormattingMode="Display" />
                                </TextBlock>-->
                            </xa:SimpleStackPanel>
                            <!--  Tag  -->
                            <xa:SimpleStackPanel
                                x:Name="tagViewer"
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="20,0,0,18"
                                Orientation="Vertical"
                                Spacing="2"
                                Visibility="{Binding IsNotFastLaunch, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <TextBlock
                                    FontFamily="{StaticResource SoraMedium}"
                                    FontSize="16"
                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                    <Run Text="{Binding Type, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontFamily="{StaticResource SoraMedium}"
                                        FontSize="16"
                                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                        <Run>
                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                <Binding Mode="OneWay" Path="Host" />
                                                <Binding Mode="OneWay" Path="Port" />
                                            </MultiBinding>
                                        </Run>
                                        <Run Text="→" />
                                        <Run Text="" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Visibility="{Binding IsHttpService, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <Run
                                            FontFamily="{StaticResource SourceCodePro}"
                                            FontSize="16"
                                            Text="{Binding Domains.Length, Mode=OneWay}" />
                                        <Run Text="个域名" />
                                    </TextBlock>
                                    <TextBlock
                                        FontFamily="{StaticResource SoraMedium}"
                                        FontSize="16"
                                        Text="{Binding RemotePort, Mode=OneWay}"
                                        Visibility="{Binding IsHasRemotePort, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                </StackPanel>
                            </xa:SimpleStackPanel>
                            <!--  Controller  -->
                            <xa:SimpleStackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,0,20,16"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">

                                <ink:HyperlinkButton
                                    x:Name="copyLink"
                                    Padding="0"
                                    AutomationProperties.HelpText=""
                                    AutomationProperties.Name="{Binding Name, StringFormat='复制隧道{0}的链接地址', Mode=OneWay}"
                                    Style="{StaticResource ButtonStyledHyperlinkButton}"
                                    TabIndex="1"
                                    ToolTip="复制链接">
                                    <Grid Margin="8.5">
                                        <ink:FontIcon
                                            x:Name="copyNormalFlag"
                                            FontSize="19.5"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ink:HyperlinkButton}, Mode=OneWay}"
                                            Icon="{x:Static ink:SegoeFluentIcons.Copy}" />
                                        <ink:FontIcon
                                            x:Name="copySuccessFlag"
                                            FontSize="19.5"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Icon="{x:Static ink:SegoeFluentIcons.CheckMark}" />
                                    </Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CopyState">
                                            <VisualState Name="CopyNormal">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        EasingFunction="{StaticResource __ApCubicEase}"
                                                        Storyboard.TargetName="copySuccessFlag"
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1"
                                                        To="0"
                                                        Duration="0:0:.3" />
                                                    <DoubleAnimation
                                                        EasingFunction="{StaticResource __ApCubicEase}"
                                                        Storyboard.TargetName="copyNormalFlag"
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0"
                                                        To="1"
                                                        Duration="0:0:.3" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState Name="CopySuccess">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        EasingFunction="{StaticResource __ApCubicEase}"
                                                        Storyboard.TargetName="copySuccessFlag"
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0"
                                                        To="1"
                                                        Duration="0:0:.3" />
                                                    <DoubleAnimation
                                                        EasingFunction="{StaticResource __ApCubicEase}"
                                                        Storyboard.TargetName="copyNormalFlag"
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1"
                                                        To="0"
                                                        Duration="0:0:.3" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </ink:HyperlinkButton>

                                <ink:HyperlinkButton
                                    x:Name="displayContextMenu"
                                    Padding="0"
                                    AutomationProperties.HelpText=""
                                    AutomationProperties.Name="{Binding Name, StringFormat='其他操作 {0}', Mode=OneWay}"
                                    BorderThickness="0"
                                    Style="{StaticResource ButtonStyledHyperlinkButton}"
                                    TabIndex="1"
                                    ToolTip="操作">
                                    <ink:FlyoutService.Flyout>
                                        <ink:MenuFlyout>
                                            <MenuItem
                                                Padding="0,3,8,3"
                                                IsEnabled="False"
                                                StaysOpenOnClick="True">
                                                <MenuItem.Header>
                                                    <TextBlock
                                                        Margin="-20,0,0,0"
                                                        FontFamily="{StaticResource SoraMedium}"
                                                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                                        <Run Text="{Binding Id, StringFormat='#{0}', Mode=OneWay}" />
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                    </TextBlock>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem
                                                CommandParameter="copy-extra-address"
                                                Header="复制扩展地址"
                                                Visibility="{Binding HasExtraConnectAddress, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                <MenuItem.Icon>
                                                    <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Copy}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="openFolder" Header="打开配置文件夹">
                                                <MenuItem.Icon>
                                                    <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.OpenInNewWindow}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="viewInfo" Header="详细">
                                                <MenuItem.Icon>
                                                    <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Info}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="editTunnel" Header="编辑">
                                                <MenuItem.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource BothConverter}">
                                                        <Binding
                                                            Converter="{StaticResource EqualConverter}"
                                                            ConverterParameter="False"
                                                            Mode="OneWay"
                                                            Path="DataContext.IsFastLaunch"
                                                            Source="{x:Reference Name=switcher}" />
                                                        <Binding
                                                            Converter="{StaticResource EqualConverter}"
                                                            ConverterParameter="False"
                                                            Mode="OneWay"
                                                            Path="IsOn"
                                                            Source="{x:Reference Name=switcher}" />
                                                    </MultiBinding>
                                                </MenuItem.IsEnabled>
                                                <MenuItem.Icon>
                                                    <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Edit}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="deleteTunnel" Header="删除">
                                                <MenuItem.Icon>
                                                    <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Delete}" />
                                                </MenuItem.Icon>
                                                <MenuItem.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource BothConverter}">
                                                        <Binding
                                                            Converter="{StaticResource EqualConverter}"
                                                            ConverterParameter="False"
                                                            Mode="OneWay"
                                                            Path="DataContext.IsFastLaunch"
                                                            Source="{x:Reference Name=switcher}" />
                                                        <Binding
                                                            Converter="{StaticResource EqualConverter}"
                                                            ConverterParameter="False"
                                                            Mode="OneWay"
                                                            Path="IsOn"
                                                            Source="{x:Reference Name=switcher}" />
                                                        <Binding
                                                            Converter="{StaticResource EqualConverter}"
                                                            ConverterParameter="False"
                                                            Mode="OneWay"
                                                            Path="DeleteCommandBinding.IsRunning"
                                                            RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                                                    </MultiBinding>
                                                </MenuItem.IsEnabled>
                                            </MenuItem>
                                        </ink:MenuFlyout>
                                    </ink:FlyoutService.Flyout>
                                    <!--<ink:HyperlinkButton.IsEnabled>
                                        <MultiBinding Converter="{StaticResource ReflagdEitherConverter}">
                                            <Binding
                                                Mode="OneWay"
                                                Path="IsOn"
                                                Source="{x:Reference Name=switcher}" />
                                            <Binding
                                                Mode="OneWay"
                                                Path="event_DefaultUserContextMenuActionCommand.IsRunning"
                                                RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                                        </MultiBinding>
                                    </ink:HyperlinkButton.IsEnabled>-->
                                    <ink:FontIcon
                                        Margin="6"
                                        FontSize="24"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ink:HyperlinkButton}, Mode=OneWay}"
                                        Icon="{x:Static ink:SegoeFluentIcons.More}" />
                                </ink:HyperlinkButton>
                            </xa:SimpleStackPanel>

                        </Grid>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  删除用户隧道的自定义 MenuItem  -->
    <Style TargetType="{x:Type local:DeleteUserTunnelContentPresenterMenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="StaysOpenOnClick" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid MinWidth="260" Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontSize="18">

                            <Run Text="真的要删除隧道" />
                            <Run FontFamily="{StaticResource SoraMedium}" Text="{Binding Id, StringFormat='#{0}', Mode=OneWay}" />
                            <Run FontFamily="{StaticResource SoraMedium}" Text="{Binding Name, Mode=OneWay}" />
                            <Run Text="吗？" />
                            <LineBreak />
                            <Run
                                FontSize="16"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Text="隧道将会永久删除,且无法被还原。" />
                            <LineBreak />
                        </TextBlock>
                        <Button
                            Name="delete_button"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{Binding Name, StringFormat='刪除隧道 {0}', Mode=OneWay}"
                            CommandParameter="{Binding Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}">
                            <xa:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                <ink:FontIcon FontSize="16" Icon="{x:Static ink:SegoeFluentIcons.Delete}" />
                                <TextBlock Text="删除" />
                            </xa:SimpleStackPanel>
                        </Button>
                        <Button
                            x:Name="cancelAndCloseFlyout"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="取消刪除"
                            Content="取消" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>