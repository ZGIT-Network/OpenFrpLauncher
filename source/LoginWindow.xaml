<local:AppWindow
    x:Class="OpenFrp.Launcher.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ofxhelper="clr-namespace:OpenFrp.Launcher.Helpers"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:wp="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Width="1090"
    Height="600"
    ink:ThemeManager.IsThemeAware="True"
    ink:ThemeManager.RequestedTheme="Default"
    ink:TitleBar.ExtendViewIntoTitleBar="True"
    ink:TitleBar.Height="34"
    ink:TitleBar.MaximizeButtonAvailability="Collapsed"
    ink:WindowHelper.UseModernWindowStyle="True"
    IsHitTestVisible="False"
    RenderOptions.ClearTypeHint="Enabled"
    ResizeMode="CanMinimize"
    ShowActivated="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Minimized"
    mc:Ignorable="d">
    <local:AppWindow.Resources>
        <CubicEase
            x:Key="_DefaultCubicEase"
            PresentationOptions:Freeze="True"
            EasingMode="EaseOut" />
    </local:AppWindow.Resources>
    <local:AppWindow.DataContext>
        <vm:LoginWindowViewModel />
    </local:AppWindow.DataContext>
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding event_MainWindowLoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
        </behavior:EventTrigger>
        <behavior:DataTrigger Value="True">
            <behavior:DataTrigger.Binding>
                <MultiBinding Converter="{StaticResource EitherConverter}" Mode="OneWay">
                    <!--<Binding Mode="OneWay" Path="event_LoginCommand.IsRunning" />-->
                    <!--<Binding Mode="OneWay" Path="event_WebLoginCommand.IsRunning" />-->
                    <Binding Mode="OneWay" Path="event_FastLoginCommand.IsRunning" />
                </MultiBinding>
            </behavior:DataTrigger.Binding>
            <behavior:InvokeCommandAction Command="{Binding event_DisplayLoadingControlCommand}" CommandParameter="{x:Static sys:Boolean.TrueString}" />
        </behavior:DataTrigger>
        <behavior:DataTrigger Value="False">
            <behavior:DataTrigger.Binding>
                <MultiBinding Converter="{StaticResource EitherConverter}" Mode="OneWay">
                    <!--<Binding Mode="OneWay" Path="event_LoginCommand.IsRunning" />-->
                    <!--<Binding Mode="OneWay" Path="event_WebLoginCommand.IsRunning" />-->
                    <Binding Mode="OneWay" Path="event_FastLoginCommand.IsRunning" />
                </MultiBinding>
            </behavior:DataTrigger.Binding>
            <behavior:InvokeCommandAction Command="{Binding event_DisplayLoadingControlCommand}" CommandParameter="{x:Static sys:Boolean.FalseString}" />
        </behavior:DataTrigger>
    </behavior:Interaction.Triggers>

    <Grid
        x:Name="app"
        d:Opacity="1"
        Opacity="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="background"
            Grid.ColumnSpan="2"
            RenderTransformOrigin=".5,.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Viewbox Stretch="UniformToFill">
                <Image
                    x:Name="bgImagePlacement"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Source="pack://application:,,,/Resources/Images/nature-6766923_1920.jpg"
                    Visibility="Visible" />
            </Viewbox>

        </Grid>
        <Grid
            Grid.ColumnSpan="2"
            Width="{Binding (ink:TitleBar.SystemOverlayRightInset), RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
            Height="{Binding (ink:TitleBar.Height), RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="{Binding ShowTitlebarBackground, Converter={StaticResource AweBooleanToVisibilityConverter}, Mode=OneWay}">
            <Rectangle
                x:Name="titleBarDarkAcrylicFill"
                Fill="#1f1f1f"
                Opacity="0" />
            <ink:AcrylicPanel
                x:Name="acrylicPanel2"
                Amount="20"
                Focusable="False"
                NoiseOpacity="0.01"
                ScaleCanvas="1.2"
                TintOpacity=".45" />

            <Rectangle
                x:Name="titleBarLightAcrylicFill"
                Fill="#75ffffff"
                Opacity="0" />

        </Grid>
        <!--  左上角图标 + 文字  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  左上角图标 + 文字  -->
            <StackPanel
                Grid.Row="0"
                Margin="36,36,0,0"
                Orientation="Horizontal">
                <Image
                    Width="36"
                    Height="36"
                    Margin="0,0,12,0"
                    ink:ClipHelper.CornerRadius="3"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Source="pack://application:,,,/Resources/Images/desktop_64w.png" />
                <Grid>
                    <TextBlock
                        x:Name="titelRender"
                        Padding="0,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SoraMediumMixYahei}"
                        FontSize="24"
                        FontWeight="Medium"
                        Foreground="White"
                        Visibility="Visible">
                        <Run>OpenFrp</Run>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <Grid Grid.Row="2" Margin="36,0,36,40">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,4">
                        <Border
                            x:Name="downloadingInfobar"
                            d:Opacity="1"
                            d:Visibility="Visible"
                            Opacity="0"
                            RenderTransformOrigin=".5,.5"
                            Style="{StaticResource BorderFocusManagedStyle}"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid Visibility="{Binding Visibility, Source={x:Reference Name=bgImagePlacement}, Mode=OneWay}">
                                    <ink:ThemeShadowChrome
                                        Margin="4"
                                        CornerRadius="6"
                                        Depth="80" />
                                    <Rectangle
                                        Margin="1"
                                        ink:ClipHelper.CornerRadius="5.5"
                                        Fill="#1f1f1f">
                                        <FrameworkElement.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <Trigger Property="ink:ThemeManager.ActualTheme" Value="Dark">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </FrameworkElement.Style>
                                    </Rectangle>
                                    <ink:AcrylicPanel
                                        x:Name="acrylicPanel4"
                                        Margin="1"
                                        Amount="20"
                                        CornerRadius="4"
                                        Focusable="False"
                                        NoiseOpacity="0.01"
                                        ScaleCanvas="1.2"
                                        TintOpacity=".45" />
                                </Grid>
                                <Border
                                    Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}"
                                    BorderBrush="{DynamicResource InfoBarBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Grid Margin="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <ink:FontIcon
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,11,0"
                                            FontSize="20"
                                            Icon="{x:Static ink:SegoeFluentIcons.CloudDownload}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Resources>
                                                    <ink:BindingProxy x:Key="IsZeroProgressResBinding" Value="{Binding DownloadProcess.ProgressValue, Converter={StaticResource NotEqualConverter}, ConverterParameter='0', Mode=OneWay}" />
                                                </StackPanel.Resources>
                                                <TextBlock>
                                                    <Run Text="正在下载" />
                                                    <Run FontFamily="{StaticResource SoraMedium}" Text="FRPC" />
                                                </TextBlock>
                                                <TextBlock
                                                    Margin="4,0,0,0"
                                                    FontFamily="{StaticResource SoraMedium}"
                                                    Visibility="{Binding Value, Converter={StaticResource AweBooleanToVisibilityConverter}, Source={StaticResource IsZeroProgressResBinding}, Mode=OneWay}">
                                                    <Run Text="{Binding DownloadProcess.ProgressValue, StringFormat='({0}%)', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Padding="0,0,0,10">
                                                <Run Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="等待下载完成后登录进程才会继续。" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock
                                                MaxWidth="375"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                FontFamily="{StaticResource SourceCodeProMixYahei}"
                                                FontSize="12"
                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                Text="{Binding DownloadProcess.DownloadFileUrl, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <ink:ProgressBar
                                                IsIndeterminate="{Binding DownloadProcess.IsIndeterminate, Mode=OneWay}"
                                                Maximum="100"
                                                ShowError="{Binding DownloadProcess.ProgressBarShowError, Mode=OneWay}"
                                                Value="{Binding DownloadProcess.ProgressValue, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="0,-6,-6,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,4,0"
                                                Padding="8"
                                                AutomationProperties.Name="重试"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding conve_TryDetectFrpcCommand}"
                                                ToolTip="重新进行下载操作"
                                                Visibility="{Binding conve_TryDetectFrpcCommand.IsRunning, ConverterParameter='Reflag', Converter={StaticResource AweBooleanToVisibilityConverter}, Mode=OneWay}">
                                                <ink:FontIcon FontSize="16" Icon="{x:Static ink:SegoeFluentIcons.Refresh}" />
                                            </Button>
                                            <!--<Button
                                                Padding="9"
                                                AutomationProperties.Name="取消下载进程"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding conve_TryDetectFrpcCancelCommand}"
                                                ToolTip="取消下载进程,同时取消登录操作。">
                                                <ink:FontIcon FontSize="14" Icon="{x:Static ink:SegoeFluentIcons.ChromeClose}" />
                                            </Button>-->
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Border
                            x:Name="executeErrorInfobar"
                            d:Opacity="1"
                            d:Visibility="Visible"
                            Opacity="0"
                            RenderTransformOrigin=".5,.5"
                            Style="{StaticResource BorderFocusManagedStyle}"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <ink:ThemeShadowChrome
                                    Margin="4"
                                    CornerRadius="6"
                                    Depth="80"
                                    Visibility="{Binding Visibility, Source={x:Reference Name=bgImagePlacement}, Mode=OneWay}" />
                                <ink:InfoBar
                                    Title="FRPC 功能异常"
                                    FontFamily="{StaticResource SoraMediumMixYahei}"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="可能由于安全软件拦截启动操作，或对 FRPC 可执行文件进行了隔离或删除。如无法确定具体原因，请点击下方‘查看’，获取网页帮助与解决方案。"
                                    Severity="Error">
                                    <ink:InfoBar.ActionButton>
                                        <Button Command="{Binding event_GotoDesktopLauncherHelpPageCommand}" Content="查看帮助" />
                                    </ink:InfoBar.ActionButton>
                                </ink:InfoBar>
                            </Grid>
                        </Border>
                        <Border
                            x:Name="newUpdateInfobar"
                            d:Opacity="1"
                            d:Visibility="Visible"
                            Opacity="0"
                            RenderTransformOrigin=".5,.5"
                            Style="{StaticResource BorderFocusManagedStyle}"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <ink:ThemeShadowChrome
                                    Margin="4"
                                    CornerRadius="6"
                                    Depth="80" />
                                <ink:InfoBar
                                    Title="有更新可用"
                                    FontFamily="{StaticResource SoraMediumMixYahei}"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{Binding UpdateLog, Mode=OneWay}"
                                    Severity="Success">
                                    <ink:InfoBar.ActionButton>
                                        <Button
                                            Margin="0,1,0,0"
                                            Command="{Binding event_InstallFrpcUpdateCommand}"
                                            Content="安装更新" />
                                    </ink:InfoBar.ActionButton>
                                </ink:InfoBar>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Visibility="Collapsed">
                        <ink:ThemeShadowChrome
                            Margin="4"
                            CornerRadius="6"
                            Depth="80"
                            IsHitTestVisible="False"
                            Visibility="{Binding Visibility, Source={x:Reference Name=bgImagePlacement}, Mode=OneWay}" />
                        <Grid IsHitTestVisible="False" Visibility="{Binding Visibility, Source={x:Reference Name=bgImagePlacement}, Mode=OneWay}">
                            <Rectangle
                                Margin="1"
                                ink:ClipHelper.CornerRadius="5.5"
                                Fill="#1f1f1f">
                                <FrameworkElement.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <Trigger Property="ink:ThemeManager.ActualTheme" Value="Dark">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </FrameworkElement.Style>
                            </Rectangle>
                            <ink:AcrylicPanel
                                x:Name="acrylicPanel3"
                                Margin="1"
                                Amount="20"
                                CornerRadius="4"
                                Focusable="False"
                                NoiseOpacity="0.01"
                                ScaleCanvas="1.2"
                                TintOpacity=".45" />
                        </Grid>
                        <ink:InfoBar
                            Title="预览版提示"
                            FontFamily="{StaticResource SoraMediumMixYahei}"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{Binding StringFormat='本软件处于开发阶段，内容仅供参考。({0})', Source={x:Static local:App.LauncherVersionString}}"
                            Severity="Informational" />
                    </Grid>
                    <!--  Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"  -->
                    <TextBlock
                        Margin="0,8,0,0"
                        FontFamily="{StaticResource SoraMediumMixYahei}"
                        FontSize="16"
                        IsHitTestVisible="False"
                        Visibility="Visible">
                        <Run Text="版权所有 ZGIT Network" />
                        <!--<LineBreak />
                        <Run Text="湘ICP备2021009274号-3" />-->
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
        <!--  主要内容  -->
        <Grid
            Grid.Column="1"
            MinWidth="400"
            Margin="0,40,60,40">
            <Grid
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Mode=OneWay}"
                MaxWidth="375"
                HorizontalAlignment="Right">
                <ink:ThemeShadowChrome
                    Margin="2"
                    CornerRadius="6"
                    Depth="60"
                    IsHitTestVisible="False"
                    Visibility="{Binding Visibility, Source={x:Reference Name=bgImagePlacement}, Mode=OneWay}" />
                <Border
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0"
                    ClipToBounds="True"
                    CornerRadius="6">
                    <Grid>
                        <Grid IsHitTestVisible="False" Visibility="{Binding Visibility, Source={x:Reference Name=bgImagePlacement}, Mode=OneWay}">
                            <Rectangle
                                x:Name="darkAcrylicFill"
                                ink:ClipHelper.CornerRadius="5.5"
                                Fill="#1f1f1f"
                                Opacity="0" />
                            <ink:AcrylicPanel
                                x:Name="acrylicPanel"
                                Amount="80"
                                CornerRadius="5.5"
                                Focusable="False"
                                IsTabStop="False"
                                NoiseOpacity="0.01"
                                TintOpacity=".45">
                                <FrameworkElement.Resources>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </FrameworkElement.Resources>
                            </ink:AcrylicPanel>
                            <Rectangle
                                x:Name="lightAcrylicFill"
                                ink:ClipHelper.CornerRadius="5.5"
                                Fill="#75ffffff"
                                Opacity="0" />

                        </Grid>

                        <Grid ClipToBounds="True" TextOptions.TextHintingMode="Auto">
                            <!--  Login Ctrl  -->
                            <Border
                                x:Name="defaultLoginCtrl"
                                RenderTransformOrigin=".5,.5"
                                Style="{StaticResource BorderFocusManagedStyle}">
                                <FrameworkElement.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </FrameworkElement.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Background="Transparent">

                                        <ink:ScrollViewerEx Margin="0" PanningMode="VerticalOnly">
                                            <wp:SimpleStackPanel Margin="24,28,24,24" Spacing="8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontSize="20">
                                                        <Run Text="登录" />
                                                        <Run FontFamily="{StaticResource SoraMedium}" Text="OpenFrp" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <ItemsControl
                                                    x:Name="selfor"
                                                    Margin="0,4,0,-8"
                                                    Focusable="False"
                                                    ItemsSource="{Binding PlatformUsers, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Margin="0,0,0,4"
                                                                Padding="12,12,16,12"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                BorderBrush="Transparent"
                                                                Command="{Binding DataContext.event_FastLoginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                                                                CommandParameter="{Binding Mode=OneWay}">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu MinWidth="100">
                                                                        <MenuItem
                                                                            Command="{Binding DataContext.event_RemoveUserRecordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                                                                            CommandParameter="{Binding Mode=OneWay}"
                                                                            Header="取消记录">
                                                                            <MenuItem.Icon>
                                                                                <ink:FontIcon Glyph="&#xF69B;" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                                <AutomationProperties.Name>
                                                                    <MultiBinding StringFormat="{}账户 {0}(邮箱: {1})">
                                                                        <Binding Mode="OneWay" Path="Username" />
                                                                        <Binding Mode="OneWay" Path="EmailAddress" />
                                                                    </MultiBinding>
                                                                </AutomationProperties.Name>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ink:PersonPicture
                                                                        x:Name="picpic"
                                                                        Grid.Column="0"
                                                                        Width="38"
                                                                        Height="38"
                                                                        ProfilePicture="pack://application:,,,/Resources/Images/weavatar.png"
                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                        UseLayoutRounding="True" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource SoraMedium}"
                                                                        FontSize="16"
                                                                        TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Username, Mode=OneWay}" />
                                                                        <LineBreak />
                                                                        <Run Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="{Binding EmailAddress, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        FontFamily="{StaticResource SoraMediumMixYahei}"
                                                                        FontSize="12"
                                                                        Visibility="Collapsed">
                                                                        <Run>6 天前</Run>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button
                                                    Margin="0,0,0,0"
                                                    Padding="12,14,8,14"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    AutomationProperties.Name="扫码登录或面板快速登录"
                                                    BorderBrush="Transparent"
                                                    Command="{Binding event_WebLogin2Command}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>

                                                        <ink:FontIcon
                                                            Grid.Column="0"
                                                            Width="38"
                                                            Height="38"
                                                            FontFamily="{StaticResource FluentSystemIcons}"
                                                            FontSize="28"
                                                            Glyph="&#xF04C;" />

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                            <TextBlock FontSize="18" Text="扫码登录 / 面板快速登录" />
                                                            <TextBlock
                                                                FontFamily="{StaticResource SoraMediumMixYahei}"
                                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                Text="安全，更快的登录方式，优先选择。"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button
                                                    Margin="0,-4,0,0"
                                                    Padding="12,14,8,14"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    AutomationProperties.Name="Natayark ID 登录"
                                                    BorderBrush="Transparent"
                                                    Command="{Binding event_WebLoginCommand}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <ink:FontIcon
                                                            Grid.Column="0"
                                                            Width="38"
                                                            Height="38"
                                                            FontFamily="{StaticResource FluentSystemIcons}"
                                                            FontSize="28"
                                                            Glyph="&#xF6BA;" />
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontFamily="{StaticResource SoraMediumMixYahei}"
                                                                FontSize="18"
                                                                Text="Natayark ID 授权登录" />
                                                            <TextBlock
                                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                Text="备选方案"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <TextBlock
                                                    Margin="0,12,0,0"
                                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap">
                                                    <Run Text="若需取消记录已登录的账户，在菜单中删除。" />
                                                    <LineBreak />
                                                    <Run Text="您也可以点击&quot;跳过登录&quot;先进入主窗口。" />
                                                </TextBlock>
                                                <Rectangle
                                                    Height="{Binding ActualHeight, Source={x:Reference Name=gl_erBar}}"
                                                    Margin="0,0,0,-20"
                                                    Visibility="{Binding IsExceptionInfobarOpen, Converter={StaticResource AweBooleanToVisibilityConverter}, Mode=OneWay}" />
                                            </wp:SimpleStackPanel>
                                        </ink:ScrollViewerEx>

                                        <ink:InfoBar
                                            x:Name="gl_erBar"
                                            Title="登录失败"
                                            Margin="24,0,24,-1"
                                            VerticalAlignment="Bottom"
                                            IsOpen="{Binding IsExceptionInfobarOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
