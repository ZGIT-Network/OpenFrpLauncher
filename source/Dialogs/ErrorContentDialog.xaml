<ink:ContentDialog
    x:Class="OpenFrp.Launcher.Dialogs.ErrorContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="详细错误内容"
    d:DesignHeight="450"
    d:DesignWidth="800"
    CloseButtonText="确定"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="复制错误内容"
    mc:Ignorable="d">
    <ink:ScrollViewerEx Margin="-24" PanningMode="VerticalOnly">
        <control:ErrorViewer
            Padding="24"
            Exception="{Binding (control:ErrorViewer.Exception), RelativeSource={RelativeSource AncestorType=ink:ContentDialog}, Mode=OneWay}"
            Focusable="False" />
    </ink:ScrollViewerEx>
</ink:ContentDialog>
