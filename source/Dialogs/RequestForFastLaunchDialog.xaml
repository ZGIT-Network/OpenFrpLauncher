<ink:ContentDialog
    x:Class="OpenFrp.Launcher.Dialogs.RequestForFastLaunchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf"
    Title="快速启动提示"
    d:DesignHeight="450"
    d:DesignWidth="800"
    PrimaryButtonText="启动"
     DefaultButton="Primary"
    CloseButtonText="取消"
    mc:Ignorable="d">
    <ui:SimpleStackPanel Spacing="8">
        <TextBlock FontSize="16" Text="要启动该隧道吗？" />
        <Border Margin="0,0,0,24"
            Width="450"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ink:FontIcon
                    Margin="16"
                    FontSize="20"
                    Glyph="&#xE8D1;" />
                <StackPanel
                    Grid.Column="1"
                    Margin="0,12,24,12"
                    VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource SoraMedium}" Text="{Binding TunnelName, RelativeSource={RelativeSource AncestorType=local:RequestForFastLaunchDialog}, Mode=OneWay}" />
                    <TextBlock TextTrimming="CharacterEllipsis" FontFamily="{StaticResource SoraMedium}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                        <Run Text="{Binding TunnelId, StringFormat='#{0}', RelativeSource={RelativeSource AncestorType=local:RequestForFastLaunchDialog}, Mode=OneWay}" />
                         |
                        <Run Text="{Binding UserToken, RelativeSource={RelativeSource AncestorType=local:RequestForFastLaunchDialog}, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="*隧道启动后只能进行日志查看&amp;关闭操作"/>
    </ui:SimpleStackPanel>
</ink:ContentDialog>