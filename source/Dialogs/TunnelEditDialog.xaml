<ink:ContentDialog
    x:Class="OpenFrp.Launcher.Dialogs.TunnelEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:control="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    d:DesignHeight="600"
    d:DesignWidth="1050"
    d:Title="修改 Dialog"
    AllowInvokeByEnter="False"
    CloseButtonClick="ContentDialog_CloseButtonClick"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="确定"
    mc:Ignorable="d">
    <FrameworkElement.Resources>
        <CubicEase
            x:Key="_DefaultCubicEase"
            PresentationOptions:Freeze="True"
            EasingMode="EaseOut" />
    </FrameworkElement.Resources>
    <ink:ScrollViewerEx Margin="-24,0" PanningMode="VerticalOnly">
        <Grid Margin="24,0">
            <Border
                x:Name="defaultContainerCtrl"
                VerticalAlignment="Top"
                RenderTransformOrigin=".5,.5"
                Style="{StaticResource BorderFocusManagedStyle}">
                <FrameworkElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <TranslateTransform X="0" Y="0" />
                    </TransformGroup>
                </FrameworkElement.RenderTransform>

                <xa:SimpleStackPanel Spacing="8">
                    <ink:InfoBar
                        x:Name="infoBar"
                        Title="操作失败"
                        Severity="Error"
                        Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource Mode=Self}, Mode=OneWay}">
                        <ink:InfoBar.ActionButton>
                            <Button
                                Margin="0,2.5,0,0"
                                Click="DisplayExceptionButton_Click"
                                Content="显示错误"
                                Visibility="{Binding Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        </ink:InfoBar.ActionButton>
                    </ink:InfoBar>
                    <control:TunnelConfEditor
                        x:Name="editor"
                        EditorTemplate="{Binding (control:TunnelConfEditor.EditorTemplate), RelativeSource={RelativeSource AncestorType=ink:ContentDialog}, Mode=OneWay}"
                        Focusable="False"
                        Node="{Binding (control:TunnelConfEditor.Node), RelativeSource={RelativeSource AncestorType=ink:ContentDialog}, Mode=OneWay}" />
                </xa:SimpleStackPanel>

            </Border>
            <Border
                x:Name="defaultLoadingCtrl"
                VerticalAlignment="Top"
                d:Visibility="Collapsed"
                Opacity="0"
                Style="{StaticResource BorderFocusManagedStyle}"
                Visibility="Collapsed">
                <FrameworkElement.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </FrameworkElement.RenderTransform>
                <Grid MinWidth="480" MinHeight="200">
                    <ink:ProgressRing Width="64" Height="64" />
                </Grid>
            </Border>
            <Border
                x:Name="defaultErrorCtrl"
                VerticalAlignment="Top"
                d:Visibility="Collapsed"
                Opacity="0"
                Style="{StaticResource BorderFocusManagedStyle}"
                Visibility="Collapsed">
                <FrameworkElement.RenderTransform>
                    <TranslateTransform X="40" Y="0" />
                </FrameworkElement.RenderTransform>
                <Grid MinWidth="480" MinHeight="200">
                    <ctrl:ErrorViewer x:Name="errViewer" Focusable="False" />
                </Grid>
            </Border>

        </Grid>
    </ink:ScrollViewerEx>
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup Name="Layout">
            <VisualState Name="DisplayContainerCtrl">
                <Storyboard>
                    <!--  Loading Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <!--  Container Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0:0:.25">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:.25" Value="True" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                        To="0"
                        Duration="0:0:.35" />
                    <!--  Error Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.X"
                        To="40"
                        Duration="0:0:.35" />
                </Storyboard>
            </VisualState>
            <VisualState Name="DisplayLoadingCtrl">
                <Storyboard>
                    <!--  Loading Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0:0:.25">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:.25" Value="True" />
                    </BooleanAnimationUsingKeyFrames>

                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        To="1"
                        Duration="0:0:.35" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                        To="1"
                        Duration="0:0:.35" />
                    <!--  Container Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                        To="0.98"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                        To="0.98"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                        To="0"
                        Duration="0:0:.25" />
                    <!--  Error Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.X"
                        To="40"
                        Duration="0:0:.25" />
                </Storyboard>
            </VisualState>
            <VisualState Name="DisplayErrorCtrl">
                <Storyboard>
                    <!--  Loading Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <!--  Container Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.2" />
                    <!--<DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                        To=".88"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                        To=".88"
                        Duration="0:0:.25" />-->
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                        To="-30"
                        Duration="0:0:.35" />
                    <!--  Error Ctrl  -->

                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0:0:.25">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:.25" Value="True" />
                    </BooleanAnimationUsingKeyFrames>

                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.X"
                        To="0"
                        Duration="0:0:.25" />

                </Storyboard>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</ink:ContentDialog>
