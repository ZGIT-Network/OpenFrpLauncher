<ink:ContentDialog
    x:Class="OpenFrp.Launcher.Dialogs.AskForUrlScehmeToolsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:control="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Title="快速启动 功能提醒"
    d:DesignHeight="600"
    d:DesignWidth="1050"
    AllowInvokeByEnter="False"
    CloseButtonText="取消并不再提醒"
    DefaultButton="Primary"
    PrimaryButtonText="应用"
    mc:Ignorable="d">
    <Grid Width="400" MinHeight="200">
        <StackPanel>
            <Image ui:ClipHelper.CornerRadius="6" Source="/Resources/Images/noc_UrlSchemeTools.png" />
            <TextBlock
                Margin="0,8,0,0"
                Text="快速启动能够帮您在单个客户端中启动来自不同用户的隧道，亦或者在启动器无法正常访问 API，但源服务器正常的情况下启动隧道。若您需要，可点击&quot;应用&quot;启用该功能。(可能会有 UAC 弹窗出现，请您点击&quot;确定&quot;来应用。)"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ink:ContentDialog>