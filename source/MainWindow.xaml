<Window
    x:Class="OpenFrp.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:OpenFrp.Launcher.Views"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Title="OPENFRP LAUNCHER"
    Width="1120"
    Height="585"
    MinWidth="550"
    MinHeight="540"
    ink:ThemeManager.RequestedTheme="Default"
    ink:TitleBar.ExtendViewIntoTitleBar="True"
    ink:TitleBar.Height="34"
    ink:WindowHelper.SystemBackdropType="Tabbed"
    ink:WindowHelper.UseModernWindowStyle="True"
    RenderOptions.ClearTypeHint="Enabled"
    mc:Ignorable="d">
    <d:FrameworkElement.DataContext>
        <vm:MainWindowViewModel />
    </d:FrameworkElement.DataContext>

    <Grid>
        <ink:NavigationView
            x:Name="viewer"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="250.5">
            <behavior:Interaction.Triggers>
                <behavior:EventTrigger EventName="Loaded">
                    <behavior:InvokeCommandAction Command="{Binding event_NavigationViewLoadedCommand}" PassEventArgsToCommand="True" />
                </behavior:EventTrigger>
            </behavior:Interaction.Triggers>
            <ink:NavigationView.MenuItems>
                <ink:NavigationViewItem Content="首页">
                    <ink:NavigationViewItem.Icon>
                        <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Home}" />
                    </ink:NavigationViewItem.Icon>
                </ink:NavigationViewItem>
                <ink:NavigationViewItem Content="隧道" Tag="{x:Type views:Tunnels}">
                    <!--<FrameworkElement.IsEnabled>
                        <MultiBinding Converter="{StaticResource BothConverter}">
                            <Binding Mode="OneWay" Path="IsDaemonConnected" />
                            <Binding Mode="OneWay" Path="IsUserLogon" />
                        </MultiBinding>
                    </FrameworkElement.IsEnabled>-->
                    <ink:NavigationViewItem.Icon>
                        <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.MultimediaDMS}" />
                    </ink:NavigationViewItem.Icon>
                </ink:NavigationViewItem>
                <ink:NavigationViewItem Content="日志" Tag="{x:Type views:Logs}">
                    <ink:NavigationViewItem.Icon>
                        <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.LineDisplay}" />
                    </ink:NavigationViewItem.Icon>
                </ink:NavigationViewItem>
            </ink:NavigationView.MenuItems>
            <ink:NavigationView.FooterMenuItems>
                <ink:NavigationViewItem Content="{Binding UserInfo.UserName, Mode=OneWay}" SelectsOnInvoked="False">
                    <ink:NavigationViewItem.Icon>
                        <ink:ImageIcon
                            ink:ClipHelper.CornerRadius="1000"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            RenderTransformOrigin=".5,.5"
                            Source="E:\Desktop\Photo\IMG_4165(20240107-124359).JPG">
                            <FrameworkElement.RenderTransform>
                                <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                            </FrameworkElement.RenderTransform>
                        </ink:ImageIcon>
                    </ink:NavigationViewItem.Icon>
                </ink:NavigationViewItem>
            </ink:NavigationView.FooterMenuItems>
            <ink:Frame x:Name="frame" Focusable="False">
                <behavior:Interaction.Triggers>
                    <behavior:EventTrigger EventName="Loaded">
                        <behavior:InvokeCommandAction Command="{Binding event_FrameLoadedCommand}" PassEventArgsToCommand="True" />
                    </behavior:EventTrigger>
                </behavior:Interaction.Triggers>
            </ink:Frame>

        </ink:NavigationView>
        <Grid
            Height="{Binding CompactPaneLength, ElementName=viewer, Mode=OneWay}"
            VerticalAlignment="Top"
            Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding CompactPaneLength, ElementName=viewer, Mode=OneWay}" />
                <ColumnDefinition Width="{Binding CompactPaneLength, ElementName=viewer, Mode=OneWay}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="1" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Setter Property="Margin" Value="0,1,0,0" />
                        <Setter Property="TextElement.FontSize" Value="15" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode, ElementName=viewer, Mode=OneWay}" Value="{x:Static ink:NavigationViewDisplayMode.Minimal}">
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="Margin" Value="-12,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Normal"
                    Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                    IsHitTestVisible="False">
                    <Run
                        FontFamily="{StaticResource SoraMedium}"
                        FontWeight="Medium"
                        Text="OpenFRP" />
                    <!--<Run Text="LAUNCHER" />-->

                </TextBlock>
            </Grid>
        </Grid>
        <xa:SimpleStackPanel
            x:Name="uiAlert"
            MaxWidth="475"
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Spacing="8">

            <!--<ink:InfoBar Severity="Success"
                Title="errr"
                IsOpen="True"
                Message="awda8d4wa4dw9a4d9a8wd4w98ad" />-->
        </xa:SimpleStackPanel>
    </Grid>
</Window>
