<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<TargetFrameworks>net48;net9.0-windows10.0.18362.0</TargetFrameworks>
	
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>Properties\App.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
	<PublishAot>false</PublishAot>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <ApplicationIcon>Resources\Images\desktop.ico</ApplicationIcon>
	  <AssemblyTitle>OpenFrp WPF 桌面端启动器</AssemblyTitle>
	  <AssemblyName>OpenFrp.Launcher</AssemblyName>
	  <AssemblyVersion>5.8.81</AssemblyVersion>
	  <Version>5.8.81</Version>
  </PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)'=='net48'">
		<LangVersion>10</LangVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net48|AnyCPU'">
	  <PreferNativeArm64>False</PreferNativeArm64>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-windows10.0.18362.0|AnyCPU'">
	  <PreferNativeArm64>False</PreferNativeArm64>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net48|AnyCPU'">
	  <PreferNativeArm64>False</PreferNativeArm64>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-windows10.0.18362.0|AnyCPU'">
	  <PreferNativeArm64>False</PreferNativeArm64>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Resources\Images\desktop.ico" />
	  <None Remove="Resources\Images\desktop_64w.png" />
	  <None Remove="Resources\Images\funx.png" />
	  <None Remove="Resources\Images\hsccode_v2.jpg" />
	  <None Remove="Resources\Images\nature-6766923_1920.jpg" />
	  <None Remove="Resources\Images\noc_UrlSchemeTools.png" />
	  <None Remove="Resources\Images\v2-bg.jpg" />
	  <None Remove="Resources\Images\weavatar.png" />
	  <None Remove="Resources\Images\[storage.sekai.best]sekai-jp-assets,character,member,res001_no035,card_after_training.png" />
	  <None Remove="Resources\Images\[storage.sekai.best]sekai-jp-assets,character,member,res001_no044,card_after_training.png" />
	  <None Remove="Resources\Images\[www.pixiv.net]artworks,129041588.png" />
	  <None Remove="Resources\OAuth\MessageWithPlaceholder.css" />
	  <None Remove="Resources\Sora-Medium.ttf" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="Resources\OAuth\MessageWithPlaceholder.css" />
	  <EmbeddedResource Include="Resources\OAuth\MessageWithPlaceholder.html" />
	</ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Images\desktop.ico" />
    <Resource Include="Resources\Images\desktop_64w.png" />
    <Resource Include="Resources\Images\nature-6766923_1920.jpg" />
    <Resource Include="Resources\Images\noc_UrlSchemeTools.png" />
    <Resource Include="Resources\Images\weavatar.png" />
    <Resource Include="Resources\Sora-Medium.ttf" />
    <Resource Include="Resources\SourceCodePro-Medium.ttf" />
	  
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="10.0.78" />
    <PackageReference Include="iNKORE.UI.WPF.Modern.Controls" Version="10.0.78" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.7" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="QRCoder" Version="1.6.0" />

   
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenFrp.Service\OpenFrp.Service.csproj" />
  </ItemGroup>
	
	
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
   <Reference Include="System.Configuration" /> 
  </ItemGroup>
	
  <ItemGroup>  
      <Compile Update="Properties\Settings.Designer.cs">
          <DesignTimeSharedInput>True</DesignTimeSharedInput>
          <AutoGen>True</AutoGen>
          <DependentUpon>Settings.settings</DependentUpon>
      </Compile>  
      <Compile Update="ViewModels\LoginWindow\OAuthLoginViewModel.cs">
        <Generator>MSBuild:Compile</Generator>
      </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Windows" />
  </ItemGroup>
</Project>
