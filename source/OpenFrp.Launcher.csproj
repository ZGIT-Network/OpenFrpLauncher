<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<TargetFrameworks>net48;net9.0-windows10.0.18362.0</TargetFrameworks>
	
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>Properties\App.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
	<PublishAot>false</PublishAot>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)'=='net48'">
		<LangVersion>10</LangVersion>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Resources\Sora-Medium.ttf" />
	</ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Sora-Medium.ttf" />
    <Resource Include="Resources\SourceCodePro-Medium.ttf" />
    <Resource Include="Resources\OAuth\index.html" />
	  <Resource Include="Resources\Images\of-logo.png" />
	  
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="iNKORE.UI.WPF.Modern.Controls" Version="1.8.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenFrp.Service\OpenFrp.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Windows" />
  </ItemGroup>
</Project>
