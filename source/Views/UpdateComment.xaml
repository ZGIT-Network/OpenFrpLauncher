<ink:Page
    x:Class="OpenFrp.Launcher.Views.UpdateComment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gapp="clr-namespace:OpenFrp.Launcher"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Title="Update"
    d:DesignHeight="835"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <FrameworkElement.DataContext>
        <vm:UpdateCommentViewModel />
    </FrameworkElement.DataContext>
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding event_PageLoadedCommand}" PassEventArgsToCommand="True" />
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <FrameworkElement.Resources>
        <CubicEase
            x:Key="_DefaultCubicEase"
            PresentationOptions:Freeze="True"
            EasingMode="EaseOut" />
    </FrameworkElement.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <xa:SimpleStackPanel
            MaxWidth="1200"
            Margin="36,40,36,8"
            Orientation="Horizontal"
            Spacing="8">
            <ink:FontIcon
                Margin="0,1,0,0"
                VerticalAlignment="Center"
                FontSize="22"
                Icon="{x:Static ink:SegoeFluentIcons.DevUpdate}" />
            <TextBlock
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontSize="24"
                Text="更新" />
        </xa:SimpleStackPanel>
        <Grid Grid.Row="1">
            <ink:ScrollViewerEx
                Focusable="False"
                PanningMode="VerticalFirst"
                VerticalScrollBarVisibility="Auto">

                <Border
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=FrameworkElement}, Mode=OneWay}"
                    MaxWidth="1272"
                    Padding="36,4,36,32"
                    HorizontalAlignment="Center">
                    <Grid TextOptions.TextHintingMode="Auto">
                        <xa:SimpleStackPanel Spacing="8">
                            <ctrl:SettingItem
                                Title="刷新"
                                Command="{Binding conve_CheckUpdateCommand}"
                                Description="如果看到的不是最新版本，请尝试点击刷新。"
                                IsClickable="True">
                                <ctrl:SettingItem.Icon>
                                    <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.Refresh}" />
                                </ctrl:SettingItem.Icon>
                            </ctrl:SettingItem>
                            <ctrl:SettingItem
                                Title="打开 FRPC 文件夹"
                                Command="{Binding event_OpenFrpcFolderCommand}"
                                Description="当你无法通过更新来获取 FRPC 时，你可以手动下载后放入 FRPC 文件夹。(注意: 请勿将未解压的 FRPC 压缩包放入，这样并不会生效)"
                                IsClickable="True">
                                <ctrl:SettingItem.Icon>
                                    <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.NewFolder}" />
                                </ctrl:SettingItem.Icon>
                            </ctrl:SettingItem>
                            <ctrl:SettingItem Title="绕过系统代理" Description="此项适用于直接访问 API 而不经过代理。">
                                <ctrl:SettingItem.Icon>
                                    <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.MultimediaDMS}" />
                                </ctrl:SettingItem.Icon>
                                <ink:ToggleSwitch
                                    MinWidth="0"
                                    IsOn="{Binding BypassProxy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsRightAlignedCompact="True" />

                            </ctrl:SettingItem>
                            <Border
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="6">
                                <xa:SimpleStackPanel Margin="20" Spacing="4">
                                    <ctrl:SelectableTextBlock
                                        HorizontalAlignment="Left"
                                        FontFamily="{StaticResource SoraMediumMixYahei}"
                                        FontSize="20"
                                        TextWrapping="Wrap">
                                        <Run Text="FRPC 版本号 :" />
                                        <Run Text="{x:Static gapp:App.FrpcVersionString}" />

                                    </ctrl:SelectableTextBlock>
                                    <ctrl:SelectableTextBlock
                                        HorizontalAlignment="Left"
                                        FontFamily="{StaticResource SoraMediumMixYahei}"
                                        FontSize="20"
                                        TextWrapping="Wrap">

                                        <Run Text="启动器 版本号 :" />
                                        <Run Text="{x:Static gapp:App.LauncherVersionString}" />
                                    </ctrl:SelectableTextBlock>
                                </xa:SimpleStackPanel>
                            </Border>

                            <!--  Vsg Container  -->
                            <Border
                                MinHeight="150"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                BorderThickness="1"
                                CornerRadius="4">

                                <Grid>
                                    <Border
                                        x:Name="defaultLoadingCtrl"
                                        d:IsHitTestVisible="False"
                                        RenderTransformOrigin=".5,.5"
                                        Style="{StaticResource BorderFocusManagedStyle}"
                                        Visibility="Collapsed">
                                        <FrameworkElement.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </FrameworkElement.RenderTransform>
                                        <ink:ProgressRing
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <Border
                                        x:Name="defaultErrorCtrl"
                                        Opacity="0"
                                        RenderTransformOrigin=".5,.5"
                                        Style="{StaticResource BorderFocusManagedStyle}"
                                        Visibility="Collapsed">
                                        <FrameworkElement.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </FrameworkElement.RenderTransform>

                                        <xa:SimpleStackPanel
                                            Margin="36,48"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Spacing="16">
                                            <ink:FontIcon
                                                HorizontalAlignment="Left"
                                                FontSize="64"
                                                Icon="{x:Static ink:SegoeFluentIcons.ThoughtBubble}" />
                                            <TextBlock FontSize="24">
                                                <Run Text="{Binding ExecuteResult.Message, Mode=OneWay}" />
                                            </TextBlock>
                                            <WrapPanel>
                                                <Button
                                                    Margin="0,0,8,8"
                                                    Padding="14,9"
                                                    AutomationProperties.Name="刷新"
                                                    Command="{Binding conve_CheckUpdateCommand}"
                                                    Style="{StaticResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Refresh}" />
                                                        <TextBlock Padding="12,0,0,0" Text="刷新" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Margin="0,0,8,8"
                                                    Padding="14,9"
                                                    AutomationProperties.Name="查看错误"
                                                    Command="{Binding event_DisplayExceptionCommand}"
                                                    Visibility="{Binding ExecuteResult.HasException, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ink:FontIcon FontSize="18" Icon="{x:Static ink:SegoeFluentIcons.Error}" />
                                                        <TextBlock Padding="8,0,0,0" Text="查看错误" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </xa:SimpleStackPanel>

                                    </Border>
                                    <Border
                                        x:Name="defaultEmptyCtrl"
                                        Opacity="0"
                                        RenderTransformOrigin=".5,.5"
                                        Style="{StaticResource BorderFocusManagedStyle}"
                                        Visibility="Collapsed">
                                        <FrameworkElement.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </FrameworkElement.RenderTransform>

                                        <xa:SimpleStackPanel
                                            Margin="36,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            TextElement.Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                            <ink:FontIcon
                                                HorizontalAlignment="Center"
                                                FontSize="64"
                                                Icon="{x:Static ink:SegoeFluentIcons.Airplane}" />
                                            <TextBlock TextWrapping="Wrap">
                                                <Run FontSize="24" Text="暂无可用的新更新..." />
                                            </TextBlock>
                                        </xa:SimpleStackPanel>
                                    </Border>
                                    <Border
                                        x:Name="defaultContainerCtrl"
                                        d:Opacity="1"
                                        Opacity="0"
                                        RenderTransformOrigin=".5,.5"
                                        Style="{StaticResource BorderFocusManagedStyle}">
                                        <FrameworkElement.RenderTransform>
                                            <TranslateTransform X="0" Y="0" />
                                        </FrameworkElement.RenderTransform>
                                        <Grid Margin="20">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <xa:SimpleStackPanel Spacing="8">
                                                <TextBlock FontSize="18" Text="{Binding Title, FallbackValue='目前无可用更新'}" />
                                                <ctrl:SelectableTextBlock
                                                    FontFamily="{StaticResource SoraMediumMixYahei}"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                    Text="{Binding Message, FallbackValue='目前无可用更新'}"
                                                    TextWrapping="Wrap" />

                                            </xa:SimpleStackPanel>
                                            <WrapPanel
                                                Grid.Row="1"
                                                Margin="0,8,0,0"
                                                VerticalAlignment="Center">
                                                <Button
                                                    Margin="0,0,10,4"
                                                    Padding="12,8"
                                                    AutomationProperties.Name="安装更新"
                                                    Command="{Binding event_InstallUpdateCommand}"
                                                    Style="{StaticResource AccentButtonStyle}">
                                                    <xa:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                                        <ink:FontIcon
                                                            VerticalAlignment="Center"
                                                            FontSize="18"
                                                            Icon="{x:Static ink:SegoeFluentIcons.RotateCamera}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Text="安装更新" />
                                                    </xa:SimpleStackPanel>
                                                </Button>
                                                <TextBlock
                                                    Margin="0,0,10,4"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                    Text="*由于当前开发时间有限，功能暂未完成开发。"
                                                    TextWrapping="Wrap" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </xa:SimpleStackPanel>
                    </Grid>
                </Border>
            </ink:ScrollViewerEx>
        </Grid>
    </Grid>
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup Name="StateCtrl">
            <VisualState Name="DisplayLoadingCtrl">
                <Storyboard>
                    <!--  Loading Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0:0:.25">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:.25" Value="True" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        To="1"
                        Duration="0:0:.35" />
                    <DoubleAnimation
