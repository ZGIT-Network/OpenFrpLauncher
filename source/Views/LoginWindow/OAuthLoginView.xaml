<UserControl
    x:Class="OpenFrp.Launcher.Views.LoginWindow.OAuthLoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views.LoginWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:wp="http://schemas.inkore.net/lib/ui/wpf"
    d:DesignHeight="490"
    d:DesignWidth="375"
    mc:Ignorable="d">
    <FrameworkElement.DataContext>
        <vm:OAuthLoginViewModel />
    </FrameworkElement.DataContext>
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding event_PageLoadedCommand}" PassEventArgsToCommand="True" />
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <wp:SimpleStackPanel
            Margin="4,4,0,0"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                Width="40"
                Height="40"
                Padding="0"
                AutomationProperties.Name="返回"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding event_CallbackRequestCommand}">
                <ink:FontIcon FontSize="16" Icon="{x:Static ink:SegoeFluentIcons.Back}" />
            </Button>
            <TextBlock
                Margin="-4,0,0,0"
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource SoraMediumMixYahei}"
                FontSize="16"
                Text="Natayark ID 登录"
                UseLayoutRounding="True" />
        </wp:SimpleStackPanel>
        <Grid Grid.Row="1" Margin="12,0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <wp:SimpleStackPanel VerticalAlignment="Center" Spacing="8">
                    <!--<ink:ProgressRing Width="100" Height="100" />-->
                    <TextBlock
                        Padding="16,0"
                        FontSize="18"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <Run FontSize="24" Text="授权中..." />
                        <LineBreak />
                        <Run Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="请点击下方中间的按钮或复制链接&#10;到浏览器中打开。" />
                    </TextBlock>
                    <ctrl:SelectableTextBlock
                        Padding="16,0"
                        FontFamily="{StaticResource SourceCodePro}"
                        FontSize="14"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                        Text="{Binding Port, StringFormat='http://127.0.0.1:{0}/callUpOAuthService', Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </wp:SimpleStackPanel>
            </Grid>
            <Grid Grid.Row="1" Background="Transparent">
                <Grid.Resources>

                    <Style BasedOn="{StaticResource ButtonStyledHyperlinkButton}" TargetType="ink:HyperlinkButton">
                        <Setter Property="RaiseHyperlinkClicks" Value="False" />
                        <Setter Property="Margin" Value="0,4,0,16" />
                        <Setter Property="Padding" Value="12" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Style>
                </Grid.Resources>
                <wp:SimpleStackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ink:HyperlinkButton
                        AutomationProperties.Name="刷新"
                        Command="{Binding event_RefreshLinkCommand}"
                        ToolTip="刷新">
                        <StackPanel Orientation="Horizontal">
                            <ink:FontIcon FontSize="20" Icon="{x:Static ink:SegoeFluentIcons.Refresh}" />
                        </StackPanel>
                    </ink:HyperlinkButton>
                    <ink:HyperlinkButton
                        AutomationProperties.Name="在浏览器中授权"
                        Command="{Binding event_OpenLinkInWebCommand}"
                        IsEnabled="{Binding event_RefreshLinkCommand.IsRunning, Converter={StaticResource EqualConverter}, ConverterParameter='False', Mode=OneWay}"
                        RenderTransformOrigin="0.5,0.5"
                        ToolTip="在浏览器中授权">

                        <StackPanel Orientation="Horizontal">
                            <ink:FontIcon
                                Height="20"
                                FontFamily="{StaticResource FluentSystemIcons}"
                                FontSize="24"
                                Glyph="&#xF583;" />
                            <TextBlock
                                Padding="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="在浏览器中授权"
                                Visibility="Visible" />
                        </StackPanel>
                    </ink:HyperlinkButton>

                    <ink:HyperlinkButton
                        AutomationProperties.Name="打开帮助页面"
                        Command="{Binding event_OpenHelpLinkInWebCommand}"
                        ToolTip="打开帮助页面">
                        <StackPanel Orientation="Horizontal">
                            <ink:FontIcon FontSize="20" Icon="{x:Static ink:SegoeFluentIcons.Help}" />
                        </StackPanel>
                    </ink:HyperlinkButton>
                </wp:SimpleStackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
