<UserControl
    x:Class="OpenFrp.Launcher.Views.LoginWindow.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views.LoginWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:wp="http://schemas.inkore.net/lib/ui/wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">

    <d:FrameworkElement.DataContext>
        <vm:SettingsViewModel />
    </d:FrameworkElement.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <wp:SimpleStackPanel
            Margin="4,4,0,0"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="callback"
                Width="40"
                Height="40"
                Padding="0"
                AutomationProperties.Name="返回"
                Background="Transparent"
                BorderThickness="0">
                <ink:FontIcon FontSize="16" Icon="{x:Static ink:SegoeFluentIcons.Back}" />
            </Button>
            <TextBlock
                Margin="-4,0,0,0"
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Text="设置"
                UseLayoutRounding="True" />
        </wp:SimpleStackPanel>
        <ink:ScrollViewerEx Grid.Row="1" PanningMode="VerticalOnly">
            <Grid Margin="24,16,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <wp:SimpleStackPanel Grid.Row="1" Spacing="8">
                    <TextBlock FontSize="18" Text="外观" />
                    <ctrl:SettingItem Title="应用主题" Description="适应一下浅色模式？">
                        <ctrl:SettingItem.Icon>


                            <ink:FontIcon
                                FontFamily="{StaticResource FluentSystemIcons}"
                                FontSize="24"
                                Glyph="&#xF0605;"
                                RenderTransformOrigin=".5,.5">
                                <FrameworkElement.RenderTransform>
                                    <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                                </FrameworkElement.RenderTransform>
                            </ink:FontIcon>
                        </ctrl:SettingItem.Icon>
                        <ComboBox
                            Width="150"
                            AutomationProperties.Name="主题色"
                            SelectedIndex="{Binding ApplicationTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="默认(跟随系统)" />
                            <ComboBoxItem Content="浅色模式" />
                            <ComboBoxItem Content="深色模式" />
                        </ComboBox>
                    </ctrl:SettingItem>
                    <ctrl:SettingItem
                        Title="窗口背景效果"
                        Description="整的挺花里胡哨的..."
                        IsEnabled="{x:Static wp:OSVersionHelper.IsWindows11OrGreater}">
                        <ctrl:SettingItem.Icon>

                            <ink:FontIcon
                                FontFamily="{StaticResource FluentSystemIcons}"
                                FontSize="24"
                                Glyph="&#xF06AB;"
                                RenderTransformOrigin=".5,.5">
                                <FrameworkElement.RenderTransform>
                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                </FrameworkElement.RenderTransform>
                            </ink:FontIcon>
                        </ctrl:SettingItem.Icon>
                        <ComboBox
                            MinWidth="150"
                            AutomationProperties.Name="窗口背景效果"
                            SelectedIndex="{Binding BackdropType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="无" />
                            <ComboBoxItem Content="Mica" />
                            <ComboBoxItem Content="Acrylic" />
                            <ComboBoxItem Content="Tabbed" />
                        </ComboBox>
                    </ctrl:SettingItem>
                    <ctrl:SettingItem Title="显示标题栏背景">
                        <ctrl:SettingItem.Icon>
                            <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.NewWindow}" />
                        </ctrl:SettingItem.Icon>
                        <ink:ToggleSwitch
                            MinWidth="0"
                            IsOn="{Binding ShowTitlebarBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsRightAlignedCompact="True" />

                    </ctrl:SettingItem>
                    <TextBlock
                        Margin="0,24,0,0"
                        FontSize="18"
                        Text="网络" />
                    <ctrl:SettingItem Title="绕过系统代理" Description="此项适用于直接访问 API 而不经过代理。">
                        <ctrl:SettingItem.Icon>
                            <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.MultimediaDMS}" />
                        </ctrl:SettingItem.Icon>
                        <ink:ToggleSwitch
                            MinWidth="0"
                            IsOn="{Binding BypassProxy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsRightAlignedCompact="True" />

                    </ctrl:SettingItem>
                    <TextBlock
                        Margin="0,24,0,0"
                        FontSize="18"
                        Text="高级功能" />
                    <ctrl:SettingItem
                        Title="打开 FRPC 文件夹"
                        Command="{Binding event_OpenFrpcFolderCommand}"
                        Description="当你无法通过更新来获取 FRPC 时，你可以手动下载后放入 FRPC 文件夹。(注意: 请勿将未解压的 FRPC 压缩包放入，这样并不会生效)"
                        IsClickable="True">
                        <ctrl:SettingItem.Icon>
                            <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.NewFolder}" />
                        </ctrl:SettingItem.Icon>
                    </ctrl:SettingItem>
                    <ctrl:SettingItem Title="系统服务模式">
                        <ctrl:SettingItem.ExtendUI>
                            <wp:SimpleStackPanel>
                                <TextBlock
                                    FontFamily="{StaticResource SoraMediumMixYahei}"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="增加一个系统服务，用于 FRPC 以及相关服务后台自启动。例如用于在登录页面时运行 FRPC 进行映射操作。" />

                                </TextBlock>
                                <ctrl:HyperlinkTp1
                                    Padding="0"
                                    Content="查看帮助"
                                    Focusable="False"
                                    FontSize="13"
                                    NavigateUri="https://docs.openfrp.net/use/desktop-launcher"
                                    ToolTip="查看&quot;系统服务&quot;的相关帮助" />
                            </wp:SimpleStackPanel>
                        </ctrl:SettingItem.ExtendUI>
                        <ctrl:SettingItem.Icon>
                            <ink:FontIcon FontSize="24" Glyph="&#xEBD2;" />
                        </ctrl:SettingItem.Icon>
                        <StackPanel Orientation="Horizontal">

                            <Button
                                d:Content="安装"
                                Command="{Binding event_CotrollServiceCommand}"
                                Style="{StaticResource AccentButtonStyle}">
                                <behavior:Interaction.Triggers>
                                    <behavior:DataTrigger Binding="{Binding IsServiceInstalled, Mode=OneWay}" Value="True">
                                        <behavior:ChangePropertyAction PropertyName="Content" Value="卸载" />
                                    </behavior:DataTrigger>
                                    <behavior:DataTrigger Binding="{Binding IsServiceInstalled, Mode=OneWay}" Value="False">
                                        <behavior:ChangePropertyAction PropertyName="Content" Value="安装" />
                                    </behavior:DataTrigger>
                                </behavior:Interaction.Triggers>
                            </Button>
                        </StackPanel>
                    </ctrl:SettingItem>

                </wp:SimpleStackPanel>
            </Grid>

        </ink:ScrollViewerEx>
    </Grid>
</UserControl>
