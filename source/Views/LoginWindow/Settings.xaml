<UserControl
    x:Class="OpenFrp.Launcher.Views.LoginWindow.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views.LoginWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:wp="http://schemas.inkore.net/lib/ui/wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">

    <d:FrameworkElement.DataContext>
        <vm:SettingsViewModel />
    </d:FrameworkElement.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <wp:SimpleStackPanel
            Margin="4,4,0,0"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="callback"
                Width="40"
                Height="40"
                Padding="0"
                AutomationProperties.Name="返回"
                Background="Transparent"
                BorderThickness="0">
                <ink:FontIcon FontSize="16" Icon="{x:Static ink:SegoeFluentIcons.Back}" />
            </Button>
            <TextBlock
                Margin="-4,0,0,0"
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Text="设置"
                UseLayoutRounding="True" />
        </wp:SimpleStackPanel>
        <ink:ScrollViewerEx Grid.Row="1" PanningMode="VerticalOnly">
            <Grid Margin="24,16,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <wp:SimpleStackPanel Grid.Row="1" Spacing="8">
                    <TextBlock FontSize="18" Text="外观" />
                    <ctrl:SettingItem Title="应用主题" Description="适应一下浅色模式？">
                        <ctrl:SettingItem.Icon>
                            <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.CharacterAppearance}" />
                        </ctrl:SettingItem.Icon>
                        <ComboBox Width="150" SelectedIndex="{Binding ApplicationTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="默认(跟随系统)" />
                            <ComboBoxItem Content="浅色模式" />
                            <ComboBoxItem Content="深色模式" />
                        </ComboBox>
                    </ctrl:SettingItem>

                </wp:SimpleStackPanel>
            </Grid>

        </ink:ScrollViewerEx>
    </Grid>
</UserControl>
