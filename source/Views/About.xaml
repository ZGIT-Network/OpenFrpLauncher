<ink:Page
    x:Class="OpenFrp.Launcher.Views.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:OpenFrp.Launcher"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Title="About"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <xa:SimpleStackPanel
            MaxWidth="1200"
            Margin="36,40,36,8"
            Orientation="Horizontal"
            Spacing="8">
            <ink:FontIcon
                Margin="0,1,0,0"
                VerticalAlignment="Center"
                FontSize="22"
                Icon="{x:Static ink:SegoeFluentIcons.Info}" />
            <TextBlock
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontSize="24">
                <Run Text="关于 启动器" />
            </TextBlock>
        </xa:SimpleStackPanel>
        <Grid Grid.Row="1">
            <ink:ScrollViewerEx
                Focusable="False"
                PanningMode="VerticalFirst"
                VerticalScrollBarVisibility="Auto">

                <Border
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=FrameworkElement}, Mode=OneWay}"
                    MaxWidth="1272"
                    Padding="36,4,36,32"
                    HorizontalAlignment="Center">
                    <Grid TextOptions.TextHintingMode="Auto">
                        <xa:SimpleStackPanel>
                            <TextBlock FontFamily="{StaticResource SoraMediumMixYahei}" FontSize="18">
                                <Run FontSize="24" Text="{x:Static app:App.UiLauncherVersionString}" />
                                <LineBreak />
                                <Run Text="版权所有 ZGIT Network" />
                                <LineBreak/>
                                <Run Text="本软件按 GPL v3 协议开源，二次开发时请注意。" />
                                <LineBreak />
                                <Run Text="星空目而不可及......赞助继续助力！" />
                            </TextBlock>
                            <ctrl:SelectableTextBlock
                                Margin="0,0,0,8"
                                Focusable="False"
                                FontSize="18"
                                Text="https://github.com/ZGIT-Network/OpenFrpLauncher"
                                TextWrapping="Wrap" />
                            <Grid
                                MaxWidth="318"
                                Margin="0,0,16,16"
                                HorizontalAlignment="Left"
                                RenderOptions.BitmapScalingMode="HighQuality">
                                <Image ink:ClipHelper.CornerRadius="6">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="../Resources/Images/hsccode_v2.jpg" />
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </xa:SimpleStackPanel>
                    </Grid>
                </Border>
            </ink:ScrollViewerEx>
        </Grid>
    </Grid>
</ink:Page>
