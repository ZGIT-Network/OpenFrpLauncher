                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                </Storyboard>
            </VisualState>
            <VisualState Name="DisplayContainerCtrl">
                <Storyboard>
                    <!--  Loading Ctrl  -->
