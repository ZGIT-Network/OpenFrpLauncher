<ink:Page
    x:Class="OpenFrp.Launcher.Views.CreateTunnel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:OpenFrp.Launcher.Model"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Title="CreateTunnel"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <FrameworkElement.Resources>
        <CubicEase
            x:Key="_DefaultCubicEase"
            PresentationOptions:Freeze="True"
            EasingMode="EaseOut" />
        <DataTemplate x:Key="TitleDataTemplate" DataType="{x:Type model:Node}">
            <TextBlock Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" Margin="0,0,0,12">
                <Run FontSize="24" Text="{Binding NodeName, Mode=OneWay}" />
                <Run
                    FontSize="16"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding Comments, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="NormalDataTemplate" DataType="{x:Type model:Node}">
            <Button
                Width="325"
                MinHeight="170"
                Margin="0,0,8,8"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Command="{Binding DataContext.event_SelectNodeAndCreteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}">
                <AutomationProperties.Name>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <Binding Mode="OneWay" Path="NodeName" />
                        <Binding
                            Mode="OneWay"
                            Path="FriendlyGroupRequire"
                            StringFormat="{}{0} 节点" />
                    </MultiBinding>
                </AutomationProperties.Name>
                <Grid Margin="20">
                    <xa:SimpleStackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock FontFamily="{StaticResource SoraMediumMixYahei}">
                            <Run FontSize="22" Text="{Binding NodeName, Mode=OneWay}" />
                            <Run
                                FontSize="18"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Text="{Binding NodeId, StringFormat='#{0}', Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            FontFamily="{StaticResource SoraMediumMixYahei}"
                            FontSize="16"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding Comments, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasComments, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <WrapPanel Margin="0,4,0,0">
                            <xa:SimpleStackPanel
                                Margin="0,0,6,4"
                                Orientation="Horizontal"
                                Spacing="2"
                                TextElement.Foreground="{DynamicResource AccentAAFillColorDefaultBrush}"
                                Visibility="{Binding ProtocolSupport.UDP, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ink:FontIcon FontSize="18" Glyph="&#xE73E;" />
                                <TextBlock
                                    Padding="0,1,0,0"
                                    FontFamily="{StaticResource SoraMedium}"
                                    FontSize="16"
                                    FontWeight="Medium"
                                    Text="UDP" />
                            </xa:SimpleStackPanel>
                            <xa:SimpleStackPanel
                                Margin="0,0,6,4"
                                Orientation="Horizontal"
                                Spacing="2"
                                TextElement.Foreground="{DynamicResource AccentAAFillColorDefaultBrush}"
                                Visibility="{Binding IsHttpSupportOnly, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ink:FontIcon FontSize="18" Glyph="&#xE73E;" />
                                <TextBlock
                                    Padding="0,1,0,0"
                                    FontFamily="{StaticResource SoraMedium}"
                                    FontSize="16"
                                    FontWeight="Medium"
                                    Text="HTTP" />
                            </xa:SimpleStackPanel>
                            <xa:SimpleStackPanel
                                Margin="0,0,6,4"
                                Orientation="Horizontal"
                                Spacing="2"
                                TextElement.Foreground="{DynamicResource AccentAAFillColorDefaultBrush}"
                                Visibility="{Binding IsHttpsSupportOnly, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ink:FontIcon FontSize="18" Glyph="&#xE73E;" />
                                <TextBlock
                                    Padding="0,1,0,0"
                                    FontFamily="{StaticResource SoraMedium}"
                                    FontSize="16"
                                    FontWeight="Medium"
                                    Text="HTTPS" />
                            </xa:SimpleStackPanel>
                            <xa:SimpleStackPanel
                                Margin="0,0,6,4"
                                Orientation="Horizontal"
                                Spacing="2"
                                TextElement.Foreground="{DynamicResource AccentAAFillColorDefaultBrush}"
                                Visibility="{Binding IsHttpOrHttpsSupport, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ink:FontIcon FontSize="18" Glyph="&#xE73E;" />
                                <TextBlock
                                    Padding="0,1,0,0"
                                    FontFamily="{StaticResource SoraMedium}"
                                    FontSize="16"
                                    FontWeight="Medium"
                                    Text="HTTP(S)" />
                            </xa:SimpleStackPanel>
                            <xa:SimpleStackPanel
                                Margin="0,0,6,4"
                                Orientation="Horizontal"
                                Spacing="2"
                                TextElement.Foreground="{DynamicResource AweAppGoldenColor}"
                                Visibility="{Binding NeedRealname, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ink:FontIcon FontSize="18" Glyph="&#xEB95;" />
                                <TextBlock
                                    Padding="2,1,0,0"
                                    FontSize="16"
                                    FontWeight="Medium"
                                    Text="需要实名" />
                            </xa:SimpleStackPanel>
                            <xa:SimpleStackPanel
                                Margin="0,0,6,4"
                                Orientation="Horizontal"
                                Spacing="2"
                                TextElement.Foreground="{DynamicResource SystemFillColorSuccessBrush}">
                                <ink:FontIcon FontSize="18" Glyph="&#xEC48;" />
                                <TextBlock
                                    Padding="0,1,0,0"
                                    FontFamily="{StaticResource SoraMedium}"
                                    FontSize="16"
                                    FontWeight="Medium"
                                    Text="{Binding BandwidthWithScaleString, Mode=OneWay}" />
                            </xa:SimpleStackPanel>
                            <xa:SimpleStackPanel
                                Margin="0,0,6,4"
                                Orientation="Horizontal"
                                Spacing="2"
                                TextElement.Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                Visibility="{Binding NotAvaliable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ink:FontIcon FontSize="18" Glyph="&#xE7BA;" />
                                <TextBlock
                                    Padding="0,1,0,0"
                                    FontSize="16"
                                    FontWeight="Medium"
                                    Text="状态异常" />
                            </xa:SimpleStackPanel>
                            <xa:SimpleStackPanel
                                Margin="0,0,6,4"
                                Orientation="Horizontal"
                                Spacing="2"
                                TextElement.Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                Visibility="{Binding IsFullyLoaded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ink:FontIcon FontSize="18" Glyph="&#xE9CA;" />
                                <TextBlock
                                    Padding="0,1,0,0"
                                    FontSize="16"
                                    FontWeight="Medium"
                                    Text="满载" />
                            </xa:SimpleStackPanel>
                        </WrapPanel>
                    </xa:SimpleStackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontFamily="{StaticResource SoraMedium}"
                        FontSize="18"
                        Foreground="{DynamicResource AweAppGoldenColor}"
                        Text="{Binding FriendlyGroupRequire, Mode=OneWay}"
                        TextWrapping="Wrap" />

                </Grid>
            </Button>
        </DataTemplate>
    </FrameworkElement.Resources>
    <FrameworkElement.DataContext>
        <vm:CreateTunnelViewModel />
    </FrameworkElement.DataContext>
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding event_PageLoadedCommand}" PassEventArgsToCommand="True" />
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <xa:SimpleStackPanel
            MaxWidth="1200"
            Margin="36,40,36,8"
            Orientation="Horizontal"
            Spacing="8">
            <ink:FontIcon
                Margin="0,1,0,0"
                VerticalAlignment="Center"
                FontSize="22"
                Icon="{x:Static ink:SegoeFluentIcons.AddSurfaceHub}" />
            <TextBlock
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontSize="24"
                Text="创建隧道" />
        </xa:SimpleStackPanel>
        <Grid Grid.Row="1">
            <ink:ScrollViewerEx
                Focusable="False"
                PanningMode="VerticalFirst"
                VerticalScrollBarVisibility="Auto">

                <Border
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=FrameworkElement}, Mode=OneWay}"
                    MaxWidth="1272"
                    Padding="36,4,36,32"
                    HorizontalAlignment="Center">
                    <Grid TextOptions.TextHintingMode="Auto">
                        <Border
                            x:Name="defaultLoadingCtrl"
                            d:IsHitTestVisible="False"
                            d:Visibility="Collapsed"
                            RenderTransformOrigin=".5,.5"
                            Style="{StaticResource BorderFocusManagedStyle}">
                            <FrameworkElement.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </FrameworkElement.RenderTransform>
                            <ctrl:Skeleton
                                BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        </Border>
                        <Border
                            x:Name="defaultErrorCtrl"
                            Opacity="0"
                            RenderTransformOrigin=".5,.5"
                            Style="{StaticResource BorderFocusManagedStyle}">
                            <FrameworkElement.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </FrameworkElement.RenderTransform>
                            <Border
                                MaxWidth="650"
                                MaxHeight="350"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <xa:SimpleStackPanel
                                    Margin="36,16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                                    <ink:FontIcon
                                        HorizontalAlignment="Left"
                                        FontSize="64"
                                        Icon="{x:Static ink:SegoeFluentIcons.ThoughtBubble}" />
                                    <TextBlock FontSize="24">
                                        <Run Text="{Binding ExecuteResult.Message, Mode=OneWay}" />
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button
                                            Margin="0,0,8,8"
                                            Padding="14,9"
                                            AutomationProperties.Name="刷新"
                                            Command="{Binding event_RefreshNodeListCommand}"
                                            Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Refresh}" />
                                                <TextBlock Padding="12,0,0,0" Text="刷新" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Margin="0,0,8,8"
                                            Padding="14,9"
                                            AutomationProperties.Name="查看错误"
                                            Command="{Binding event_DisplayExceptionCommand}"
                                            Visibility="{Binding ExecuteResult.HasException, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <ink:FontIcon FontSize="18" Icon="{x:Static ink:SegoeFluentIcons.Error}" />
                                                <TextBlock Padding="8,0,0,0" Text="查看错误" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </xa:SimpleStackPanel>
                            </Border>
                        </Border>
                        <Border
                            x:Name="defaultContainerCtrl"
                            d:Opacity="1"
                            Opacity="0"
                            RenderTransformOrigin=".5,.5"
                            Style="{StaticResource BorderFocusManagedStyle}">
                            <FrameworkElement.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </FrameworkElement.RenderTransform>
                            <Grid>
                                <ItemsControl x:Name="itemsController" ItemsSource="{Binding Nodes, IsAsync=True, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplateSelector>
                                        <model:NodeDataTemplateSelector NormalTemplate="{StaticResource NormalDataTemplate}" TitleTemplate="{StaticResource TitleDataTemplate}" />
                                    </ItemsControl.ItemTemplateSelector>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="FrameworkElement">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFullyLoaded}" Value="True">
                                                    <Setter Property="Opacity" Value=".8" />
                                                </DataTrigger>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                FillBehavior="Stop"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0"
                                                                To="1"
                                                                Duration="0:0:.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <!--<ItemsControl.ItemTemplate />-->
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>

                </Border>
            </ink:ScrollViewerEx>
        </Grid>
    </Grid>
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup Name="StateCtrl">
            <VisualState Name="DisplayLoadingCtrl">
                <Storyboard>
                    <!--  Loading Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0:0:.25">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:.25" Value="True" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        To="1"
                        Duration="0:0:.35" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                        To="1"
                        Duration="0:0:.35" />
                    <!--  Error Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        To="0.95"
                        Duration="0:0:.35" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                        To="0.95"
                        Duration="0:0:.35" />
                    <!--  Container Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                </Storyboard>
            </VisualState>
            <VisualState Name="DisplayErrorCtrl">
                <Storyboard>
                    <!--  Loading Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        To="0.95"
                        Duration="0:0:.35" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                        To="0.95"
                        Duration="0:0:.35" />
                    <!--  Error Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0:0:.25">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:.25" Value="True" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        To="1"
                        Duration="0:0:.35" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                        To="1"
                        Duration="0:0:.35" />

                    <!--  Container Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                </Storyboard>
            </VisualState>

            <VisualState Name="DisplayContainerCtrl">
                <Storyboard>
                    <!--  Loading Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        To="0.95"
                        Duration="0:0:.35" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultLoadingCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                        To="0.95"
                        Duration="0:0:.35" />
                    <!--  Error Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0.35">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0">
                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:.15" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        To="0.95"
                        Duration="0:0:.35" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultErrorCtrl"
                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                        To="0.95"
                        Duration="0:0:.35" />

                    <!--  Container Ctrl  -->
                    <ObjectAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0:0:0">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <BooleanAnimationUsingKeyFrames
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="IsHitTestVisible"
                        Duration="0:0:.25">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:.25" Value="True" />
                    </BooleanAnimationUsingKeyFrames>
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:.25" />
                    <!--<DoubleAnimation
                     EasingFunction="{StaticResource _DefaultCubicEase}"
                     Storyboard.TargetName="defaultContainerCtrl"
                     Storyboard.TargetProperty="RenderTransform.ScaleX"
                     To="1"
                     Duration="0:0:.35" />-->
                    <DoubleAnimation
                        EasingFunction="{StaticResource _DefaultCubicEase}"
                        FillBehavior="Stop"
                        Storyboard.TargetName="defaultContainerCtrl"
                        Storyboard.TargetProperty="RenderTransform.Y"
                        From="10"
                        To="0"
                        Duration="0:0:.35" />
                </Storyboard>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</ink:Page>
