<ink:Page
    x:Class="OpenFrp.Launcher.Views.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Title="Settings"
    d:DesignHeight="895"
    d:DesignWidth="525"
    mc:Ignorable="d">
    <FrameworkElement.Resources>

        <conv:LongToByteDanceConverter x:Key="LongToByteDanceConverter" />
        <conv:LongToByteSpeedConverter x:Key="LongToByteSpeedConverter" />
        <conv:BooleanToStringConverter
            x:Key="RealNameStateConverter"
            DefaultFalseString="未实名"
            DefaultTrueString="已实名" />
        <ink:BindingProxy x:Key="IsUserLogin" Value="{Binding UserInfo.UserName, Converter={StaticResource NotEqualConverter}, ConverterParameter='non-display-user', Mode=OneWay}" />
        <ink:BindingProxy x:Key="IsNotUserLogin" Value="{Binding UserInfo.UserName, Converter={StaticResource EqualConverter}, ConverterParameter='non-display-user', Mode=OneWay}" />
    </FrameworkElement.Resources>
    <FrameworkElement.DataContext>
        <vm:SettingsViewModel />
    </FrameworkElement.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <xa:SimpleStackPanel
            MaxWidth="1200"
            Margin="36,40,36,8"
            Orientation="Horizontal"
            Spacing="8">
            <ink:FontIcon
                Margin="0,1,0,0"
                VerticalAlignment="Center"
                FontSize="22"
                Icon="{x:Static ink:SegoeFluentIcons.Settings}" />
            <TextBlock
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontSize="24"
                Text="设置" />
        </xa:SimpleStackPanel>
        <Grid Grid.Row="1">
            <ink:ScrollViewerEx
                Focusable="False"
                PanningMode="VerticalFirst"
                VerticalScrollBarVisibility="Auto">

                <Border
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=FrameworkElement}, Mode=OneWay}"
                    MaxWidth="1272"
                    Padding="36,4,36,32"
                    HorizontalAlignment="Center">
                    <xa:SimpleStackPanel Spacing="8">

                        <TextBlock FontSize="18" Text="账户" />
                        <Grid>
                            <Border
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="6"
                                Visibility="{Binding Value, Source={StaticResource IsUserLogin}, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <Grid>
                                    <!--  Main Content  -->
                                    <xa:SimpleStackPanel
                                        Margin="24"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Spacing="12">
                                        <!--  ProfilePicture="E:\Desktop\Photo\IMG_9865.JPG"  -->
                                        <ink:PersonPicture
                                            Width="48"
                                            Height="48"
                                            HorizontalAlignment="Left"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                            <behavior:Interaction.Triggers>
                                                <behavior:DataTrigger Binding="{Binding UserAvatorSource, Mode=OneWay}" Value="{x:Null}">
                                                    <behavior:ChangePropertyAction PropertyName="ProfilePicture">
                                                        <behavior:ChangePropertyAction.Value>
                                                            <BitmapImage UriSource="pack://application:,,,/Resources/Images/weavatar.png" />
                                                        </behavior:ChangePropertyAction.Value>
                                                    </behavior:ChangePropertyAction>
                                                </behavior:DataTrigger>
                                                <behavior:DataTrigger
                                                    Binding="{Binding UserAvatorSource, Mode=OneWay}"
                                                    Comparison="NotEqual"
                                                    Value="{x:Null}">
                                                    <behavior:ChangePropertyAction PropertyName="ProfilePicture" Value="{Binding UserAvatorSource, Mode=OneWay}" />
                                                </behavior:DataTrigger>
                                            </behavior:Interaction.Triggers>
                                        </ink:PersonPicture>
                                        <TextBlock FontFamily="{StaticResource SoraMediumMixYahei}" TextWrapping="Wrap">
                                            <Run FontSize="24" Text="{Binding UserInfo.UserName, Mode=OneWay}" />
                                            <Run
                                                FontSize="16"
                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                Text="{Binding UserInfo.GroupCName, Mode=OneWay}" />
                                            <LineBreak />
                                            <Run
                                                FontSize="18"
                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                Text="{Binding UserInfo.Email, Mode=OneWay}" />

                                        </TextBlock>
                                        <TextBlock FontSize="16" TextWrapping="Wrap">
                                            <Run Text="{Binding UserInfo.IsRealname, Converter={StaticResource RealNameStateConverter}, Mode=OneWay}" />
                                            <Run Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Text=" | " />
                                            <TextBlock>
                                                <Run Text="剩余流量 " />
                                                <Run
                                                    FontFamily="{StaticResource SoraMedium}"
                                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                    Text="{Binding UserInfo.Traffic, Converter={StaticResource LongToByteDanceConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                            <Run Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Text=" | " />
                                            <TextBlock Margin="0,1,0,-1">
                                                <ink:FontIcon
                                                    Margin="0,0,0,0"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                    Icon="{x:Static ink:SegoeFluentIcons.NetworkAdapter}" />
                                                <Run
                                                    FontFamily="{StaticResource SoraMedium}"
                                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                    Text="{Binding UserInfo.InputLimit, Converter={StaticResource LongToByteSpeedConverter}, StringFormat='{}{0} (Up)', Mode=OneWay}" />
                                                <Run Text="/" />
                                                <Run
                                                    FontFamily="{StaticResource SoraMedium}"
                                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                    Text="{Binding UserInfo.InputLimit, Converter={StaticResource LongToByteSpeedConverter}, StringFormat='{}{0} (Down)', Mode=OneWay}" />
                                            </TextBlock>

                                        </TextBlock>
                                    </xa:SimpleStackPanel>
                                    <!--  Left Top  -->
                                    <xa:SimpleStackPanel
                                        Margin="20"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                        <Button
                                            Padding="8"
                                            AutomationProperties.Name="更多账户设置"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsEnabled="{Binding event_LogoutCommand.IsRunning, Converter={StaticResource NotEqualConverter}, ConverterParameter='True', Mode=OneWay}"
                                            ToolTip="更多账户设置">
                                            <ink:FontIcon FontSize="20" Icon="{x:Static ink:SegoeFluentIcons.More}" />
                                            <ink:FlyoutService.Flyout>
                                                <ink:MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem
                                                        MinWidth="125"
                                                        Command="{Binding event_RefreshUserInfoCommand, Mode=OneWay}"
                                                        Header="刷新"
                                                        IsEnabled="{Binding event_LogoutCommand.IsRunning, Converter={StaticResource NotEqualConverter}, ConverterParameter='True', Mode=OneWay}">
                                                        <MenuItem.Icon>
                                                            <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Refresh}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        MinWidth="125"
                                                        Command="{Binding event_LogoutCommand}"
                                                        Header="退出登录">
                                                        <MenuItem.Icon>
                                                            <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.SignOut}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ink:MenuFlyout>
                                            </ink:FlyoutService.Flyout>
                                        </Button>
                                    </xa:SimpleStackPanel>
                                    <!--  Process  -->
                                    <ink:ProgressBar
                                        VerticalAlignment="Bottom"
                                        IsHitTestVisible="False"
                                        IsIndeterminate="{Binding event_RefreshUserInfoCommand.IsRunning, Mode=OneWay}"
                                        Visibility="{Binding event_RefreshUserInfoCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <ctrl:SettingItem
                                Title="登录账户"
                                AutomationProperties.Name="登录账户"
                                Command="{Binding event_CallUpLoginWindowCommand}"
                                IsClickable="True"
                                Visibility="{Binding Value, Source={StaticResource IsNotUserLogin}, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ctrl:SettingItem.ExtendUI>
                                    <FrameworkElement Visibility="Collapsed" />
                                </ctrl:SettingItem.ExtendUI>
                                <ctrl:SettingItem.Icon>
                                    <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.Accounts}" />
                                </ctrl:SettingItem.Icon>
                            </ctrl:SettingItem>
                        </Grid>
                        <TextBlock FontSize="18" Text="外观" />
                        <ctrl:SettingItem Title="应用主题" Description="适应一下浅色模式？">
                            <ctrl:SettingItem.Icon>
                                <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.CharacterAppearance}" />
                            </ctrl:SettingItem.Icon>
                            <ComboBox
                                Width="150"
                                AutomationProperties.Name="主题色"
                                SelectedIndex="{Binding ApplicationTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="默认(跟随系统)" />
                                <ComboBoxItem Content="浅色模式" />
                                <ComboBoxItem Content="深色模式" />
                            </ComboBox>
                        </ctrl:SettingItem>
                        <ctrl:SettingItem Title="窗口背景效果" Description="整的挺花里胡哨的...">
                            <ctrl:SettingItem.Icon>
                                <ink:FontIcon FontSize="24" Glyph="&#xEB1D;" />
                            </ctrl:SettingItem.Icon>
                            <ComboBox
                                Width="150"
                                AutomationProperties.Name="窗口背景效果"
                                SelectedIndex="{Binding BackdropType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="无" />
                                <ComboBoxItem Content="Mica" />
                                <ComboBoxItem Content="Acrylic" />
                                <ComboBoxItem Content="Tabbed" />
                            </ComboBox>
                        </ctrl:SettingItem>
                        <ctrl:SettingExpander
                            Title="显示字体"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Description="适用于日志页面的显示。"
                            ExpandDirection="Down"
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            <ctrl:SettingExpander.Icon>
                                <ink:FontIcon FontSize="24" Glyph="&#xEC34;" />
                            </ctrl:SettingExpander.Icon>
                            <xa:SimpleStackPanel Margin="4" Spacing="8">
                                <TextBlock FontSize="18" Text="字体" />
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ink:NumberBox
                                        ink:ControlHelper.Header="字号"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Inline"
                                        Value="{Binding FontSize, Source={x:Reference Name=fontPreview}, FallbackValue=12, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <behavior:Interaction.Triggers>
                                            <behavior:EventTrigger EventName="Loaded">
                                                <behavior:InvokeCommandAction Command="{Binding event_FontNumberOrFamilySelectorCommand}" PassEventArgsToCommand="True" />
                                            </behavior:EventTrigger>
                                        </behavior:Interaction.Triggers>

                                    </ink:NumberBox>
                                    <ComboBox
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        ink:ControlHelper.Header="字体"
                                        ItemsSource="{Binding FontDisplays}"
                                        SelectedValue="{Binding SelectedFont, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    FontFamily="{Binding Font, Mode=OneWay}"
                                                    Text="{Binding Name, Mode=OneWay}"
                                                    TextWrapping="NoWrap" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <behavior:Interaction.Triggers>
                                            <behavior:EventTrigger EventName="Loaded">
                                                <behavior:InvokeCommandAction Command="{Binding event_FontNumberOrFamilySelectorCommand}" PassEventArgsToCommand="True" />
                                            </behavior:EventTrigger>
                                        </behavior:Interaction.Triggers>
                                    </ComboBox>
                                </Grid>
                                <TextBlock
                                    x:Name="fontPreview"
                                    FontFamily="{Binding SelectedFont.Font, Mode=OneWay}"
                                    FontSize="16"
                                    TextWrapping="Wrap">
                                    <Run Text="2025/04/06 17:37" />
                                    <Run Foreground="{DynamicResource AweAppGoldenColor}" Text="Launcher" />
                                    <Run Text="[I] 中文内容 English Content 123456789 (!@#$%^&amp;*) = Char[]" />
                                </TextBlock>

                            </xa:SimpleStackPanel>

                        </ctrl:SettingExpander>

                        <TextBlock
                            Margin="0,24,0,0"
                            FontSize="18"
                            Text="网络" />
                        <ctrl:SettingItem Title="绕过系统代理" Description="此项适用于直接访问 API 而不经过代理。">
                            <ctrl:SettingItem.Icon>
                                <ink:FontIcon FontSize="24" Icon="{x:Static ink:SegoeFluentIcons.MultimediaDMS}" />
                            </ctrl:SettingItem.Icon>
                            <ink:ToggleSwitch
                                MinWidth="0"
                                IsOn="{Binding BypassProxy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsRightAlignedCompact="True" />

                        </ctrl:SettingItem>
                    </xa:SimpleStackPanel>
                </Border>
            </ink:ScrollViewerEx>
        </Grid>
    </Grid>

</ink:Page>
