<ink:Page
    x:Class="OpenFrp.Launcher.Views.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:OpenFrp.Launcher"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Title="Home"
    d:DesignHeight="760"
    d:DesignWidth="865"
    mc:Ignorable="d">
    <FrameworkElement.DataContext>
        <vm:HomeViewModel />
    </FrameworkElement.DataContext>
    <FrameworkElement.Resources>
        <conv:RescaleConverter x:Key="RescaleConverter" IsWidthToHeightScale="True" />

        <ink:BindingProxy x:Key="IsUserLogin" Value="{Binding UserInfo.UserName, Converter={StaticResource NotEqualConverter}, ConverterParameter='non-display-user', Mode=OneWay}" />
        <ink:BindingProxy x:Key="IsNotUserLogin" Value="{Binding UserInfo.UserName, Converter={StaticResource EqualConverter}, ConverterParameter='non-display-user', Mode=OneWay}" />
    </FrameworkElement.Resources>
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding event_PageLoadedCommand}" PassEventArgsToCommand="True" />
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <xa:SimpleStackPanel
            MaxWidth="1200"
            Margin="36,40,36,8"
            Orientation="Horizontal"
            Spacing="8">
            <ink:FontIcon
                Margin="0,1,0,0"
                VerticalAlignment="Center"
                FontSize="22"
                Icon="{x:Static ink:SegoeFluentIcons.Home}" />
            <TextBlock
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontSize="24"
                Text="首页" />
        </xa:SimpleStackPanel>
        <Grid Grid.Row="1">
            <ink:ScrollViewerEx
                Focusable="False"
                PanningMode="VerticalFirst"
                VerticalScrollBarVisibility="Auto">

                <Border
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=FrameworkElement}, Mode=OneWay}"
                    MaxWidth="1272"
                    Padding="36,4,36,32"
                    HorizontalAlignment="Center">
                    <Grid TextOptions.TextHintingMode="Auto">

                        <xa:SimpleStackPanel>
                            <Grid x:Name="cRoot" Margin="0,0,0,8">
                                <behavior:Interaction.Triggers>
                                    <behavior:DataTrigger
                                        Binding="{Binding ActualWidth, ElementName=cRoot, Mode=OneWay}"
                                        Comparison="GreaterThanOrEqual"
                                        Value="740">
                                        <behavior:ChangePropertyAction PropertyName="Tag" Value="{x:Null}" />
                                    </behavior:DataTrigger>
                                    <behavior:DataTrigger
                                        Binding="{Binding ActualWidth, ElementName=cRoot, Mode=OneWay}"
                                        Comparison="LessThan"
                                        Value="740">
                                        <behavior:ChangePropertyAction PropertyName="Tag" Value="small" />
                                    </behavior:DataTrigger>
                                </behavior:Interaction.Triggers>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="8" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" MaxWidth="850" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition MinWidth="250" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="contentDat"
                                    Height="{Binding ActualWidth, Converter={StaticResource RescaleConverter}, RelativeSource={RelativeSource Mode=Self}, Mode=OneWay}"
                                    MaxHeight="400"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0"
                                    CornerRadius="4.75">
                                    <Border.Style>
                                        <Style>
                                            <Setter Property="Grid.ColumnSpan" Value="1" />
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.Row" Value="0" />
                                            <Setter Property="Grid.RowSpan" Value="3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=cRoot, Mode=OneWay}" Value="small">
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                    <Setter Property="Grid.Row" Value="0" />
                                                    <Setter Property="Grid.RowSpan" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Resources>
                                        <ink:BindingProxy x:Key="IsNotRunning" Value="{Binding event_RefreshAdSenseCommand.IsRunning, Converter={StaticResource EqualConverter}, ConverterParameter='False', Mode=OneWay}" />
                                    </Border.Resources>
                                    <Grid>
                                        <ink:ProgressRing
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsActive="{Binding event_RefreshAdSenseCommand.IsRunning, Mode=OneWay}"
                                            Visibility="{Binding event_RefreshAdSenseCommand.IsRunning, Converter={StaticResource AweBooleanToVisibilityConverter}, Mode=OneWay}" />
                                        <ctrl:Carousel
                                            AlternationCount="100"
                                            AutoPlay="True"
                                            CornerRadius="4.45"
                                            IsHitTestVisible="{Binding Value, Source={StaticResource IsNotRunning}, Mode=OneWay}"
                                            ItemsSource="{Binding AdSences, Mode=OneWay}">
                                            <ctrl:Carousel.Background>
                                                <ImageBrush ImageSource="pack://application:,,,/Resources/Images/[storage.sekai.best]sekai-jp-assets,character,member,res001_no035,card_after_training.png" Stretch="UniformToFill" />
                                            </ctrl:Carousel.Background>
                                            <ctrl:Carousel.Visibility>
                                                <Binding
                                                    Mode="OneWay"
                                                    Path="Value"
                                                    Source="{StaticResource IsNotRunning}">
                                                    <Binding.Converter>
                                                        <conv:AweBooleanToVisibilityConverter IsCollapsed="False" />
                                                    </Binding.Converter>
                                                </Binding>
                                            </ctrl:Carousel.Visibility>
                                            <ctrl:Carousel.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Image
                                                            IsHitTestVisible="False"
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            Source="{Binding ImageSource, Mode=OneWay}"
                                                            Stretch="UniformToFill" />
                                                        <Rectangle Fill="Black" IsHitTestVisible="False">
                                                            <Rectangle.OpacityMask>
                                                                <LinearGradientBrush StartPoint=".5,.4" EndPoint=".5,1">
                                                                    <GradientStop Color="#6A000000" />
                                                                    <GradientStop Offset="1" Color="Transparent" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.OpacityMask>
                                                        </Rectangle>
                                                        <StackPanel Margin="15,20" ink:ThemeManager.RequestedTheme="Dark">
                                                            <ink:HyperlinkButton
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Focusable="False"
                                                                NavigateUri="{Binding Url, Mode=OneWay}">
                                                                <ink:HyperlinkButton.ToolTip>
                                                                    <ToolTip ink:ThemeManager.RequestedTheme="{Binding Source={x:Static app:App.ApplicationTheme}, Mode=OneWay}" Content="{Binding Url, Mode=OneWay}" />
                                                                </ink:HyperlinkButton.ToolTip>
                                                                <xa:SimpleStackPanel Spacing="4">
                                                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                                        <ink:InfoBadge
                                                                            Width="8"
                                                                            Height="8"
                                                                            Background="{DynamicResource SystemAccentColorLight3Brush}" />
                                                                        <TextBlock Padding="5,0,0,0" Foreground="#8FFFFFFF">
                                                                            <Run Text="官方广告 -" />
                                                                            <Run
                                                                                FontFamily="{StaticResource SoraMediumMixYahei}"
                                                                                Foreground="{DynamicResource AweAppGoldenColor}"
                                                                                Text="{Binding Company, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock TextWrapping="Wrap">
                                                                        <Run
                                                                            FontSize="22"
                                                                            Foreground="#FFFFFF"
                                                                            Text="{Binding Title, Mode=OneWay}" />
                                                                        <LineBreak />
                                                                        <Run
                                                                            FontFamily="{StaticResource SoraMediumMixYahei}"
                                                                            FontSize="18"
                                                                            Foreground="#8FFFFFFF"
                                                                            Text="{Binding Description, Mode=OneWay}" />
                                                                        <!--<Run Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />-->
                                                                    </TextBlock>
                                                                </xa:SimpleStackPanel>
                                                            </ink:HyperlinkButton>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ctrl:Carousel.ItemTemplate>
                                        </ctrl:Carousel>
                                    </Grid>
                                </Border>
                                <Border
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4.75">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="0" />
                                            <Setter Property="Grid.RowSpan" Value="3" />
                                            <Setter Property="Grid.Column" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=cRoot}" Value="small">
                                                    <Setter Property="Grid.Row" Value="2" />
                                                    <Setter Property="Grid.Column" Value="0" />
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                    <Setter Property="Grid.RowSpan" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, ElementName=cRoot}" Value="{x:Null}">
                                                    <Setter Property="MaxHeight" Value="{Binding ActualHeight, Source={x:Reference Name=contentDat}, Mode=OneWay}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid x:Name="userInfoViewer" Visibility="{Binding Value, Source={StaticResource IsUserLogin}, Converter={StaticResource AweBooleanToVisibilityConverter}, Mode=OneWay}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <behavior:Interaction.Triggers>
                                                <behavior:DataTrigger
                                                    Binding="{Binding ActualWidth, ElementName=cRoot, Mode=OneWay}"
                                                    Comparison="GreaterThanOrEqual"
                                                    Value="740">
                                                    <behavior:ChangePropertyAction PropertyName="Tag" Value="{x:Null}" />
                                                </behavior:DataTrigger>
                                                <behavior:DataTrigger
                                                    Binding="{Binding ActualWidth, ElementName=cRoot, Mode=OneWay}"
                                                    Comparison="LessThan"
                                                    Value="740">
                                                    <behavior:ChangePropertyAction PropertyName="Tag" Value="small" />
                                                </behavior:DataTrigger>
                                            </behavior:Interaction.Triggers>
                                            <StackPanel Margin="20,20,20,12" Orientation="Horizontal">
                                                <ink:FontIcon
                                                    VerticalAlignment="Top"
                                                    FontSize="20"
                                                    Icon="{x:Static ink:SegoeFluentIcons.GuestUser}" />
                                                <TextBlock
                                                    Padding="8,0,0,0"
                                                    VerticalAlignment="Top"
                                                    FontSize="18"
                                                    Text="用户信息" />
                                            </StackPanel>
                                            <Grid Grid.Row="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ctrl:AdaptScrollViewer>
                                                    <Grid Margin="20,0,20,0" Background="Transparent">

                                                        <ItemsControl ItemsSource="{Binding UserInfoVex2, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Background="Transparent">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ink:FontIcon x:Name="ap_icon" Glyph="{Binding Icon, Mode=OneWay}" />
                                                                        <TextBlock x:Name="ap_title" Text="{Binding Title, Mode=OneWay}" />
                                                                        <TextBlock
                                                                            x:Name="ap_description"
                                                                            FontFamily="{StaticResource SoraMediumMixYahei}"
                                                                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                            Text="{Binding Description, Mode=OneWay}"
                                                                            TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=userInfoViewer, Mode=OneWay}" Value="{x:Null}">
                                                                            <Setter TargetName="ap_icon" Property="Grid.Row" Value="0" />
                                                                            <Setter TargetName="ap_icon" Property="Grid.RowSpan" Value="3" />
                                                                            <Setter TargetName="ap_icon" Property="Grid.Column" Value="0" />
                                                                            <Setter TargetName="ap_icon" Property="FontSize" Value="20" />

                                                                            <Setter TargetName="ap_title" Property="Margin" Value="8,0,0,0" />
                                                                            <Setter TargetName="ap_title" Property="Grid.Row" Value="0" />
                                                                            <Setter TargetName="ap_title" Property="Grid.Column" Value="1" />
                                                                            <Setter TargetName="ap_title" Property="FontSize" Value="17" />

                                                                            <Setter TargetName="ap_description" Property="Grid.Column" Value="1" />
                                                                            <Setter TargetName="ap_description" Property="Grid.Row" Value="1" />
                                                                            <Setter TargetName="ap_description" Property="FontSize" Value="15" />
                                                                            <Setter TargetName="ap_description" Property="Margin" Value="8,0,0,0" />

                                                                            <Setter Property="Margin" Value="0,0,0,12" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=userInfoViewer, Mode=OneWay}" Value="small">
                                                                            <Setter TargetName="ap_icon" Property="Grid.Row" Value="0" />
                                                                            <Setter TargetName="ap_icon" Property="Grid.RowSpan" Value="1" />
                                                                            <Setter TargetName="ap_icon" Property="Grid.Column" Value="0" />
                                                                            <Setter TargetName="ap_icon" Property="HorizontalAlignment" Value="Left" />
                                                                            <Setter TargetName="ap_icon" Property="FontSize" Value="22" />

                                                                            <Setter TargetName="ap_title" Property="Margin" Value="0,8,0,0" />
                                                                            <Setter TargetName="ap_title" Property="Grid.Row" Value="1" />
                                                                            <Setter TargetName="ap_title" Property="Grid.Column" Value="0" />
                                                                            <Setter TargetName="ap_title" Property="FontSize" Value="18" />

                                                                            <Setter TargetName="ap_description" Property="Grid.Column" Value="0" />
                                                                            <Setter TargetName="ap_description" Property="Grid.Row" Value="2" />
                                                                            <Setter TargetName="ap_description" Property="FontSize" Value="16" />
                                                                            <Setter TargetName="ap_description" Property="Margin" Value="0,4,0,0" />
                                                                            <Setter TargetName="ap_description" Property="VerticalAlignment" Value="Top" />

                                                                            <Setter Property="Width" Value="210" />
                                                                            <Setter Property="MinHeight" Value="60" />
                                                                            <Setter Property="Margin" Value="0,6,6,6" />
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=userInfoViewer, Mode=OneWay}" Value="{x:Null}">
                                                                            <Setter Property="Control.Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Mode=OneWay}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                        </ItemsControl>

                                                    </Grid>
                                                </ctrl:AdaptScrollViewer>
                                                <xa:SimpleStackPanel
                                                    Grid.Row="1"
                                                    Margin="20,8,20,20"
                                                    Orientation="Horizontal"
                                                    Spacing="16">
                                                    <ctrl:HyperlinkTp1
                                                        Padding="0"
                                                        AutomationProperties.Name="打开官网"
                                                        Command="{Binding event_OpenOpenFrpNetCommand}"
                                                        Cursor="Hand">
                                                        <xa:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                                            <ink:FontIcon FontSize="16" Icon="{x:Static ink:SegoeFluentIcons.OpenInNewWindow}" />
                                                            <TextBlock FontSize="16" Text="打开官网" />
                                                        </xa:SimpleStackPanel>
                                                    </ctrl:HyperlinkTp1>
                                                    <ctrl:HyperlinkTp1
                                                        Padding="0"
                                                        AutomationProperties.Name="赞助者列表"
                                                        Command="{Binding event_OpenPaymentAppCommand}"
                                                        Cursor="Hand">
                                                        <xa:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                                            <ink:FontIcon FontSize="17" Icon="{x:Static ink:SegoeFluentIcons.GiftboxOpen}" />
                                                            <TextBlock FontSize="16" Text="赞助者列表" />
                                                        </xa:SimpleStackPanel>
                                                    </ctrl:HyperlinkTp1>
                                                </xa:SimpleStackPanel>
                                            </Grid>
                                        </Grid>
                                        <Grid Visibility="{Binding Value, Source={StaticResource IsNotUserLogin}, Converter={StaticResource AweBooleanToVisibilityConverter}, Mode=OneWay}">
                                            <Grid.Style>
                                                <Style>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, ElementName=userInfoViewer, Mode=OneWay}" Value="small">
                                                            <Setter Property="Control.MinHeight" Value="200" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <xa:SimpleStackPanel
                                                Margin="24,0"
                                                VerticalAlignment="Center"
                                                Orientation="Vertical"
                                                Spacing="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="24"
                                                    Text="登录后即可查看个人信息"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                                <ink:HyperlinkButton
                                                    Padding="8"
                                                    HorizontalAlignment="Center"
                                                    AutomationProperties.Name="登录"
                                                    Command="{Binding event_GotoSettingPageCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ink:FontIcon FontSize="20" Icon="{x:Static ink:SegoeFluentIcons.Settings}" />
                                                        <TextBlock
                                                            Padding="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Text="前往设置页面登录" />
                                                    </StackPanel>
                                                </ink:HyperlinkButton>
                                            </xa:SimpleStackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <!--<Border
                                    MaxWidth="213"
                                    Margin="0,0,8,16"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="6">
                                    <Grid>
                                        <Image
                                            ink:ClipHelper.CornerRadius="6"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="../Resources/Images/alipay.jpg" />

                                        <TextBlock
                                            Margin="0,36,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            FontSize="14"
                                            Foreground="Black"
                                            IsHitTestVisible="False"
                                            TextAlignment="Center">

                                            <Run Text="支付宝 (这不是购买 VIP 的码)" />
                                        </TextBlock>
                                    </Grid>
                                </Border>-->
                                <Border
                                    MaxWidth="318"
                                    Margin="0,0,8,16"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="6">
                                    <Grid>
                                        <Image ink:ClipHelper.CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="../Resources/Images/mm_reward_qrcode_light.png" />
                                                    <Style.Triggers>
                                                        <Trigger Property="ink:ThemeManager.ActualTheme" Value="Dark">
                                                            <Setter Property="Source" Value="../Resources/Images/mm_reward_qrcode_dark.png" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <TextBlock
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            FontSize="12"
                                            Foreground="#afafaf"
                                            IsHitTestVisible="False"
                                            TextAlignment="Center">
                                            <Run Text="请注意:要进入赞助列表请勿匿名赞助" />
                                            <LineBreak />
                                            <Run Text="微信 (这不是购买 VIP 的码)" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </WrapPanel>

                        </xa:SimpleStackPanel>
                    </Grid>
                </Border>
            </ink:ScrollViewerEx>
        </Grid>
    </Grid>
</ink:Page>
