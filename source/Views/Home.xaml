<ink:Page
    x:Class="OpenFrp.Launcher.Views.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:OpenFrp.Launcher"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:ctrl="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenFrp.Launcher.ViewModels"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Title="Home"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <FrameworkElement.DataContext>
        <vm:HomeViewModel />
    </FrameworkElement.DataContext>
    <FrameworkElement.Resources>
        <conv:RescaleConverter x:Key="RescaleConverter" IsWidthToHeightScale="True" />
    </FrameworkElement.Resources>
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding event_PageLoadedCommand}" PassEventArgsToCommand="True" />
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <xa:SimpleStackPanel
            MaxWidth="1200"
            Margin="36,40,36,8"
            Orientation="Horizontal"
            Spacing="8">
            <ink:FontIcon
                Margin="0,1,0,0"
                VerticalAlignment="Center"
                FontSize="22"
                Icon="{x:Static ink:SegoeFluentIcons.Home}" />
            <TextBlock
                Padding="0,0,0,0"
                VerticalAlignment="Center"
                FontSize="24"
                Text="首页" />
        </xa:SimpleStackPanel>
        <Grid Grid.Row="1">
            <ink:ScrollViewerEx
                Focusable="False"
                PanningMode="VerticalFirst"
                VerticalScrollBarVisibility="Auto">

                <Border
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=FrameworkElement}, Mode=OneWay}"
                    MaxWidth="1272"
                    Padding="36,4,36,32"
                    HorizontalAlignment="Center">
                    <Grid TextOptions.TextHintingMode="Auto">

                        <xa:SimpleStackPanel>
                            <Grid x:Name="cRoot" Margin="0,0,0,8">
                                <behavior:Interaction.Triggers>
                                    <behavior:DataTrigger
                                        Binding="{Binding ActualWidth, ElementName=cRoot, Mode=OneWay}"
                                        Comparison="GreaterThanOrEqual"
                                        Value="740">
                                        <behavior:ChangePropertyAction PropertyName="Tag" Value="{x:Null}" />
                                    </behavior:DataTrigger>
                                    <behavior:DataTrigger
                                        Binding="{Binding ActualWidth, ElementName=cRoot, Mode=OneWay}"
                                        Comparison="LessThan"
                                        Value="740">
                                        <behavior:ChangePropertyAction PropertyName="Tag" Value="small" />
                                    </behavior:DataTrigger>
                                </behavior:Interaction.Triggers>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="8" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" MaxWidth="850" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition MinWidth="250" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="contentDat"
                                    Height="{Binding ActualWidth, Converter={StaticResource RescaleConverter}, RelativeSource={RelativeSource Mode=Self}, Mode=OneWay}"
                                    MaxHeight="400"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4.75">
                                    <Border.Style>
                                        <Style>
                                            <Setter Property="Grid.ColumnSpan" Value="1" />
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.Row" Value="0" />
                                            <Setter Property="Grid.RowSpan" Value="3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=cRoot, Mode=OneWay}" Value="small">
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                    <Setter Property="Grid.Row" Value="0" />
                                                    <Setter Property="Grid.RowSpan" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Resources>
                                        <ink:BindingProxy x:Key="IsNotRunning" Value="{Binding event_RefreshAdSenseCommand.IsRunning, Converter={StaticResource EqualConverter}, ConverterParameter='False', Mode=OneWay}" />
                                    </Border.Resources>
                                    <Grid>

                                        <ink:ProgressRing
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsActive="{Binding event_RefreshAdSenseCommand.IsRunning, Mode=OneWay}"
                                            Visibility="{Binding event_RefreshAdSenseCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />


                                        <ctrl:Carousel
                                            AlternationCount="100"
                                            AutoPlay="True"
                                            CornerRadius="4.45"
                                            IsHitTestVisible="{Binding Value, Source={StaticResource IsNotRunning}, Mode=OneWay}"
                                            ItemsSource="{Binding AdSences, Mode=OneWay}">
                                            <ctrl:Carousel.Background>
                                                <ImageBrush ImageSource="pack://application:,,,/Resources/Images/[www.pixiv.net]artworks,129041588.png" Stretch="UniformToFill" />
                                            </ctrl:Carousel.Background>
                                            <ctrl:Carousel.Visibility>
                                                <Binding
                                                    Mode="OneWay"
                                                    Path="Value"
                                                    Source="{StaticResource IsNotRunning}">
                                                    <Binding.Converter>
                                                        <conv:BooleanToVisibilityConverter IsCollapsed="False" />
                                                    </Binding.Converter>
                                                </Binding>
                                            </ctrl:Carousel.Visibility>
                                            <ctrl:Carousel.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Image
                                                            IsHitTestVisible="False"
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            Source="{Binding ImageSource, Mode=OneWay}"
                                                            Stretch="UniformToFill" />
                                                        <Rectangle Fill="Black" IsHitTestVisible="False">
                                                            <Rectangle.OpacityMask>
                                                                <LinearGradientBrush StartPoint=".5,.4" EndPoint=".5,1">
                                                                    <GradientStop Color="#6A000000" />
                                                                    <GradientStop Offset="1" Color="Transparent" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.OpacityMask>
                                                        </Rectangle>
                                                        <StackPanel Margin="15,20" ink:ThemeManager.RequestedTheme="Dark">
                                                            <ink:HyperlinkButton
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Focusable="False"
                                                                NavigateUri="{Binding Url, Mode=OneWay}">
                                                                <ink:HyperlinkButton.ToolTip>
                                                                    <ToolTip ink:ThemeManager.RequestedTheme="{Binding Source={x:Static app:App.ApplicationTheme}, Mode=OneWay}" Content="{Binding Url, Mode=OneWay}" />
                                                                </ink:HyperlinkButton.ToolTip>
                                                                <xa:SimpleStackPanel Spacing="4">
                                                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                                        <ink:InfoBadge
                                                                            Width="8"
                                                                            Height="8"
                                                                            Background="{DynamicResource SystemAccentColorLight3Brush}" />
                                                                        <TextBlock Padding="5,0,0,0" Foreground="#8FFFFFFF">
                                                                            <Run Text="官方广告 -" />
                                                                            <Run
                                                                                FontFamily="{StaticResource SoraMediumMixYahei}"
                                                                                Foreground="{DynamicResource AweAppGoldenColor}"
                                                                                Text="{Binding Company, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock TextWrapping="Wrap">
                                                                        <Run
                                                                            FontSize="22"
                                                                            Foreground="#FFFFFF"
                                                                            Text="{Binding Title, Mode=OneWay}" />
                                                                        <LineBreak />
                                                                        <Run
                                                                            FontFamily="{StaticResource SoraMediumMixYahei}"
                                                                            FontSize="18"
                                                                            Foreground="#8FFFFFFF"
                                                                            Text="{Binding Description, Mode=OneWay}" />
                                                                        <Run Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </xa:SimpleStackPanel>
                                                            </ink:HyperlinkButton>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ctrl:Carousel.ItemTemplate>
                                        </ctrl:Carousel>
                                        <Button Content="Focus Helper" Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>

                                    <!--<Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="20,20,20,6" Orientation="Horizontal">
                                            <ink:FontIcon
                                                VerticalAlignment="Top"
                                                FontSize="20" Margin="0,2,0,0"
                                                Icon="{x:Static ink:SegoeFluentIcons.System}" />
                                            <TextBlock
                                                Padding="8,0,0,0"
                                                VerticalAlignment="Top"
                                                FontSize="18"
                                                Text="智能推送" />
                                        </StackPanel>
                                        <xa:SimpleStackPanel Grid.Row="1">
                                            <TextBlock Text="Content" />
                                        </xa:SimpleStackPanel>
                                    </Grid>-->
                                </Border>
                                <Border
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4.75">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="0" />
                                            <Setter Property="Grid.RowSpan" Value="3" />
                                            <Setter Property="Grid.Column" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=cRoot}" Value="small">
                                                    <Setter Property="Grid.Row" Value="2" />
                                                    <Setter Property="Grid.Column" Value="0" />
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                    <Setter Property="Grid.RowSpan" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, ElementName=cRoot}" Value="{x:Null}">
                                                    <Setter Property="MaxHeight" Value="{Binding ActualHeight, Source={x:Reference Name=contentDat}, Mode=OneWay}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid x:Name="userInfoViewer">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <behavior:Interaction.Triggers>
                                            <behavior:DataTrigger
                                                Binding="{Binding ActualWidth, ElementName=cRoot, Mode=OneWay}"
                                                Comparison="GreaterThanOrEqual"
                                                Value="740">
                                                <behavior:ChangePropertyAction PropertyName="Tag" Value="{x:Null}" />
                                            </behavior:DataTrigger>
                                            <behavior:DataTrigger
                                                Binding="{Binding ActualWidth, ElementName=cRoot, Mode=OneWay}"
                                                Comparison="LessThan"
                                                Value="740">
                                                <behavior:ChangePropertyAction PropertyName="Tag" Value="small" />
                                            </behavior:DataTrigger>
                                        </behavior:Interaction.Triggers>
                                        <StackPanel Margin="16,18,16,5" Orientation="Horizontal">
                                            <ink:FontIcon
                                                VerticalAlignment="Top"
                                                FontSize="20"
                                                Icon="{x:Static ink:SegoeFluentIcons.GuestUser}" />
                                            <TextBlock
                                                Padding="8,0,0,0"
                                                VerticalAlignment="Top"
                                                FontSize="18"
                                                Text="用户信息" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <ctrl:AdaptScrollViewer>
                                                <Grid Height="800" Margin="16,0,16,16">
                                                    <TextBlock Text="{Binding Tag, ElementName=userInfoViewer, Mode=OneWay}" />
                                                </Grid>
                                            </ctrl:AdaptScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid
                                MaxWidth="318"
                                Margin="0,0,16,16"
                                HorizontalAlignment="Left"
                                RenderOptions.BitmapScalingMode="HighQuality">
                                <Image ink:ClipHelper.CornerRadius="6">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="../Resources/Images/hsccode_v2.jpg" />
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <TextBlock
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    FontSize="12"
                                    Foreground="#afafaf"
                                    IsHitTestVisible="False"
                                    TextAlignment="Center">
                                    <Run Text="请注意:要进入赞助列表请勿匿名赞助" />
                                    <LineBreak />
                                    <Run Text="微信" />
                                </TextBlock>
                            </Grid>
                        </xa:SimpleStackPanel>
                    </Grid>
                </Border>
            </ink:ScrollViewerEx>
        </Grid>
    </Grid>
</ink:Page>
