<Window
    x:Class="OpenFrp.Launcher.WebView2Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:awe="clr-namespace:OpenFrp.Launcher.Controls"
    xmlns:conv="clr-namespace:OpenFrp.Launcher.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ink="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:local="clr-namespace:OpenFrp.Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
    Width="800"
    Height="550"
    MinWidth="800"
    MinHeight="500"
    Background="Transparent"
    Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
    ResizeMode="CanResizeWithGrip"
    mc:Ignorable="d">
    <Window.Resources>
        <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />

    </Window.Resources>
    <Grid>
        <wv:WebView2
            x:Name="wv"
            d:Visibility="Collapsed"
            CoreWebView2InitializationCompleted="wv_CoreWebView2InitializationCompleted"
            DefaultBackgroundColor="Transparent"
            Source="{Binding Source, RelativeSource={RelativeSource AncestorType=local:WebView2Window}, Mode=OneWay}"
            Visibility="{Binding Exception, ConverterParameter='Reflag', Converter={StaticResource AweBooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=local:WebView2Window}, Mode=OneWay}" />
        <!--    -->
        <Grid Visibility="{Binding Exception, Converter={StaticResource AweBooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=local:WebView2Window}, Mode=OneWay}">
            <ink:ScrollViewerEx HorizontalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <xa:SimpleStackPanel
                    Margin="36,64"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <ink:FontIcon
                        HorizontalAlignment="Left"
                        FontSize="64"
                        Icon="{x:Static ink:SegoeFluentIcons.ThoughtBubble}" />
                    <TextBlock FontSize="24" TextWrapping="Wrap">
                        <Run Text="{Binding Exception.Message, RelativeSource={RelativeSource AncestorType=local:WebView2Window}, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel>
                        <Button
                            x:Name="refreshButton"
                            Margin="0,0,8,8"
                            Padding="14,9"
                            AutomationProperties.Name="刷新"
                            Click="refreshButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ink:FontIcon Icon="{x:Static ink:SegoeFluentIcons.Refresh}" />
                                <TextBlock Padding="12,0,0,0" Text="刷新" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,8"
                            Padding="14,9"
                            AutomationProperties.Name="查看错误"
                            Click="displayExceptionButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ink:FontIcon FontSize="18" Icon="{x:Static ink:SegoeFluentIcons.Error}" />
                                <TextBlock Padding="8,0,0,0" Text="查看错误" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel Orientation="Vertical" Visibility="{Binding IsWebView2RuntimeException, Converter={StaticResource AweBooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=local:WebView2Window}, Mode=OneWay}">
                        <TextBlock
                            FontFamily="{StaticResource SoraMediumMixYahei}"
                            FontSize="16"
                            TextWrapping="Wrap">
                            <Run
                                FontSize="18"
                                FontWeight="Bold"
                                Text="如何安装 Microsft WebView2" />
                            <LineBreak />
                            <Run Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="最新版 Webview2 只适用于 Windows 10 及以上平台，其他平台请选择旧版本(固定版本)。" />
                            <LineBreak />
                        </TextBlock>
                        <awe:SelectableTextBlock
                            FontFamily="{StaticResource SoraMediumMixYahei}"
                            FontSize="16"
                            TextWrapping="Wrap">
                            <Run Text="1. 浏览器打开" />
                            <LineBreak />
                            <Run FontFamily="{StaticResource SourceCodePro}" Text="https://developer.microsoft.com/zh-cn/microsoft-edge/webview2/" />
                            <LineBreak />
                            <Run Text="2. 点击下载，然后打开安装程序，根据指导安装。" />
                            <LineBreak />
                            <Run Text="3. 重启 OpenFRP Launcher。" />
                        </awe:SelectableTextBlock>
                    </StackPanel>
                </xa:SimpleStackPanel>
            </ink:ScrollViewerEx>
        </Grid>
    </Grid>
</Window>
